#!/usr/bin/env bash

set -Eeuo pipefail

SCRIPT_DIR=$(cd -- "$(dirname "${BASH_SOURCE[0]}")" && pwd)
REPO_ROOT=$(cd -- "${SCRIPT_DIR}/.." && pwd)

die() {
  printf 'error: %s\n' "$*" >&2
  exit 1
}

print_stage() {
  printf '==> %s\n' "$1"
}

require_commands() {
  local missing=()
  local command_name

  for command_name in "$@"; do
    if ! command -v "${command_name}" >/dev/null 2>&1; then
      missing+=("${command_name}")
    fi
  done

  if ((${#missing[@]} > 0)); then
    die "missing required command(s): ${missing[*]}"
  fi
}

require_value() {
  local option=$1
  local value=${2:-}

  [[ -n "${value}" && "${value}" != --* ]] || die "${option} requires a value"
}

expand_path() {
  local path=$1
  local home_prefix

  printf -v home_prefix '%b' '\x7e/'

  if [[ "${path:0:2}" == "${home_prefix}" ]]; then
    printf '%s/%s\n' "${HOME}" "${path#~/}"
    return
  fi

  printf '%s\n' "${path}"
}

absolute_path() {
  local path
  path=$(expand_path "$1")

  if [[ "${path}" == /* ]]; then
    printf '%s\n' "${path}"
  else
    printf '%s/%s\n' "$(pwd -P)" "${path}"
  fi
}

TF_DIR=$(absolute_path "${CUDA_KERNEL_LAB_TF_DIR:-${REPO_ROOT}/infra/env/aws-gpu}")
TF_VARS_FILE=$(absolute_path "${CUDA_KERNEL_LAB_TF_VARS_FILE:-${TF_DIR}/local.auto.tfvars}")
if [[ -n "${CUDA_KERNEL_LAB_TF_VARS_FILE:-}" ]]; then
  TF_VARS_FILE_EXPLICIT=1
else
  TF_VARS_FILE_EXPLICIT=0
fi
STATE_DIR=$(absolute_path "${CUDA_KERNEL_LAB_AWS_STATE_DIR:-${REPO_ROOT}/.aws-gpu}")
KEY_DIR="${STATE_DIR}/keys"
CONNECTION_FILE="${STATE_DIR}/connection.env"

AWS_REGION_NAME="${AWS_REGION:-us-west-2}"
AWS_PROFILE_NAME="${AWS_PROFILE:-}"
INSTANCE_TYPE="g5.xlarge"
INSTANCE_NAME="cuda-kernel-lab-gpu"
VOLUME_SIZE_GB=100
AMI_SSM_PARAMETER="/aws/service/deeplearning/ami/x86_64/base-oss-nvidia-driver-gpu-ubuntu-22.04/latest/ami-id"
SSH_USER="ubuntu"
REMOTE_DIR="cuda-kernel-lab"

KEY_NAME=""
KEY_FILE=""
DEFAULT_KEY_MANAGED=0
SUBNET_ID=""
VPC_ID=""
SECURITY_GROUP_ID=""
INGRESS_CIDR=""
VPC_CIDR="10.42.0.0/16"
PUBLIC_SUBNET_CIDR="10.42.1.0/24"
ASSOCIATE_PUBLIC_IP=1
SKIP_BOOTSTRAP=0
DRY_RUN=0

INSTANCE_ID=""
SSH_HOST=""

usage() {
  cat <<EOF
Usage:
  ./scripts/up [options]

Creates one disposable AWS EC2 GPU host for CUDA benchmark runs, then syncs
this repo and bootstraps the benchmark environment. When no key is provided,
the script creates or reuses a project-local dev key under .aws-gpu/keys/.

Options:
  --key-name <name>             EC2 key pair name override. Requires --key-file for bootstrap.
  --key-file <path>             SSH private key override. Requires --key-name.
  --profile <name>              AWS CLI profile used by Terraform.
  --region <name>               AWS region. Default: ${AWS_REGION_NAME}
  --instance-type <type>        EC2 GPU instance. Default: ${INSTANCE_TYPE}
  --name <name>                 EC2 Name tag. Default: ${INSTANCE_NAME}
  --volume-size-gb <gb>         Root EBS size. Default: ${VOLUME_SIZE_GB}
  --ami-ssm-parameter <name>    Public SSM parameter for the DLAMI.
  --vpc-id <id>                 Existing VPC. When set without --subnet-id, the first subnet is used.
  --subnet-id <id>              Existing subnet. Defaults to a disposable public subnet.
  --security-group-id <id>      Existing security group. Defaults to EC2-module-created SSH group.
  --ingress-cidr <cidr>         SSH source CIDR for EC2-module-created security group.
  --vpc-cidr <cidr>             CIDR for the disposable VPC. Default: ${VPC_CIDR}
  --public-subnet-cidr <cidr>   CIDR for the disposable public subnet. Default: ${PUBLIC_SUBNET_CIDR}
  --ssh-user <name>             SSH user. Default: ${SSH_USER}
  --remote-dir <path>           Remote repo directory under the SSH user's home.
  --no-public-ip                Do not associate a public IPv4 address.
  --skip-bootstrap              Create infra only; do not SSH, sync, or install dependencies.
  --dry-run                     Write tfvars and print the launch configuration without Terraform.
  --tf-dir <path>               Terraform environment. Default: ${TF_DIR}
  --tf-vars-file <path>         Terraform variable file. Default: ${TF_VARS_FILE}

Examples:
  ./scripts/up
  ./scripts/up --key-name kernel-lab --key-file ~/.ssh/kernel-lab.pem
  ./scripts/up --profile personal --instance-type g6.xlarge --key-name kernel-lab --key-file ~/.ssh/kernel-lab.pem
  ./scripts/up --skip-bootstrap
  ./scripts/down
EOF
}

parse_args() {
  while (($# > 0)); do
    case "$1" in
      -h|--help)
        usage
        exit 0
        ;;
      --key-name)
        require_value "$1" "${2:-}"
        KEY_NAME=${2:-}
        shift 2
        ;;
      --key-file)
        require_value "$1" "${2:-}"
        KEY_FILE=$(absolute_path "${2:-}")
        shift 2
        ;;
      --profile)
        require_value "$1" "${2:-}"
        AWS_PROFILE_NAME=${2:-}
        shift 2
        ;;
      --region)
        require_value "$1" "${2:-}"
        AWS_REGION_NAME=${2:-}
        shift 2
        ;;
      --instance-type)
        require_value "$1" "${2:-}"
        INSTANCE_TYPE=${2:-}
        shift 2
        ;;
      --name)
        require_value "$1" "${2:-}"
        INSTANCE_NAME=${2:-}
        shift 2
        ;;
      --volume-size-gb)
        require_value "$1" "${2:-}"
        VOLUME_SIZE_GB=${2:-}
        shift 2
        ;;
      --ami-ssm-parameter)
        require_value "$1" "${2:-}"
        AMI_SSM_PARAMETER=${2:-}
        shift 2
        ;;
      --vpc-id)
        require_value "$1" "${2:-}"
        VPC_ID=${2:-}
        shift 2
        ;;
      --subnet-id)
        require_value "$1" "${2:-}"
        SUBNET_ID=${2:-}
        shift 2
        ;;
      --security-group-id)
        require_value "$1" "${2:-}"
        SECURITY_GROUP_ID=${2:-}
        shift 2
        ;;
      --ingress-cidr)
        require_value "$1" "${2:-}"
        INGRESS_CIDR=${2:-}
        shift 2
        ;;
      --vpc-cidr)
        require_value "$1" "${2:-}"
        VPC_CIDR=${2:-}
        shift 2
        ;;
      --public-subnet-cidr)
        require_value "$1" "${2:-}"
        PUBLIC_SUBNET_CIDR=${2:-}
        shift 2
        ;;
      --ssh-user)
        require_value "$1" "${2:-}"
        SSH_USER=${2:-}
        shift 2
        ;;
      --remote-dir)
        require_value "$1" "${2:-}"
        REMOTE_DIR=${2:-}
        shift 2
        ;;
      --no-public-ip)
        ASSOCIATE_PUBLIC_IP=0
        shift
        ;;
      --skip-bootstrap)
        SKIP_BOOTSTRAP=1
        shift
        ;;
      --dry-run)
        DRY_RUN=1
        shift
        ;;
      --tf-dir)
        require_value "$1" "${2:-}"
        TF_DIR=$(absolute_path "${2:-}")
        if [[ "${TF_VARS_FILE_EXPLICIT}" == "0" ]]; then
          TF_VARS_FILE="${TF_DIR}/local.auto.tfvars"
        fi
        shift 2
        ;;
      --tf-vars-file)
        require_value "$1" "${2:-}"
        TF_VARS_FILE=$(absolute_path "${2:-}")
        TF_VARS_FILE_EXPLICIT=1
        shift 2
        ;;
      *)
        die "unknown argument: $1"
        ;;
    esac
  done
}

default_key_suffix() {
  local suffix

  suffix=${USER:-$(id -un 2>/dev/null || printf 'user')}
  suffix=${suffix//[^A-Za-z0-9._-]/-}
  printf '%s\n' "${suffix}"
}

resolve_default_key() {
  if [[ -z "${KEY_NAME}" && -z "${KEY_FILE}" && "${SKIP_BOOTSTRAP}" == "0" ]]; then
    DEFAULT_KEY_MANAGED=1
    KEY_NAME="cuda-kernel-lab-$(default_key_suffix)"
    KEY_FILE="${KEY_DIR}/${KEY_NAME}.pem"
  fi
}

check_prereqs() {
  if [[ "${DRY_RUN}" == "0" ]]; then
    require_commands terraform
  fi

  if [[ "${DRY_RUN}" == "0" && "${DEFAULT_KEY_MANAGED}" == "1" ]]; then
    require_commands aws ssh-keygen
  fi

  if [[ "${DRY_RUN}" == "0" ]] && ssh_access_requested && [[ -z "${SECURITY_GROUP_ID}" && -z "${INGRESS_CIDR}" ]]; then
    require_commands curl
  fi

  if [[ "${DRY_RUN}" == "0" && "${SKIP_BOOTSTRAP}" == "0" && -n "${KEY_FILE}" ]]; then
    require_commands ssh tar
  fi
}

ssh_access_requested() {
  [[ -n "${KEY_NAME}" || -n "${KEY_FILE}" ]]
}

validate_inputs() {
  [[ "${VOLUME_SIZE_GB}" =~ ^[0-9]+$ ]] || die "--volume-size-gb must be an integer"
  ((VOLUME_SIZE_GB >= 40)) || die "--volume-size-gb must be at least 40"
  [[ -d "${TF_DIR}" ]] || die "Terraform directory does not exist: ${TF_DIR}"
  [[ "${SSH_USER}" =~ ^[A-Za-z_][A-Za-z0-9_.-]*[$]?$ ]] || die "--ssh-user contains unsafe characters"
  [[ "${REMOTE_DIR}" =~ ^[A-Za-z0-9._/-]+$ ]] || die "--remote-dir contains unsafe characters"
  [[ "${REMOTE_DIR}" != /* && "${REMOTE_DIR}" != *..* ]] || die "--remote-dir must be a relative path without '..'"
  [[ "${REMOTE_DIR}" != "." && "${REMOTE_DIR}" != .* && "${REMOTE_DIR}" != */.* ]] || die "--remote-dir must not target hidden or current-directory paths"

  if [[ "${DEFAULT_KEY_MANAGED}" == "0" && -n "${KEY_FILE}" && ! -f "${KEY_FILE}" ]]; then
    die "SSH key file does not exist: ${KEY_FILE}"
  fi

  if [[ -n "${KEY_FILE}" && -z "${KEY_NAME}" ]]; then
    die "--key-name is required when --key-file is provided"
  fi

  if [[ "${SKIP_BOOTSTRAP}" == "0" && -z "${KEY_FILE}" ]]; then
    printf 'No --key-file was provided; Terraform will create infra without SSH bootstrap.\n'
    SKIP_BOOTSTRAP=1
  fi
}

resolve_ingress_cidr() {
  local public_ip

  if [[ -n "${SECURITY_GROUP_ID}" || -n "${INGRESS_CIDR}" ]]; then
    return
  fi

  if ! ssh_access_requested; then
    return
  fi

  if [[ "${DRY_RUN}" == "1" ]]; then
    return
  fi

  public_ip=$(curl -fsS --max-time 10 https://checkip.amazonaws.com | tr -d '[:space:]') || {
    die "could not discover public IP; pass --ingress-cidr"
  }
  [[ -n "${public_ip}" ]] || die "empty public IP discovery response; pass --ingress-cidr"

  INGRESS_CIDR="${public_ip}/32"
}

hcl_string() {
  local value=$1

  value=${value//\\/\\\\}
  value=${value//\"/\\\"}
  value=${value//$'\n'/\\n}
  printf '"%s"' "${value}"
}

write_string_var() {
  local name=$1
  local value=$2

  printf '%s = ' "${name}"
  hcl_string "${value}"
  printf '\n'
}

write_optional_string_var() {
  local name=$1
  local value=$2

  if [[ -n "${value}" ]]; then
    printf '%s = ' "${name}"
    hcl_string "${value}"
    printf '\n'
  fi
}

write_bool_var() {
  local name=$1
  local value=$2

  if [[ "${value}" == "1" ]]; then
    printf '%s = true\n' "${name}"
  else
    printf '%s = false\n' "${name}"
  fi
}

write_tfvars() {
  mkdir -p "$(dirname "${TF_VARS_FILE}")"

  {
    write_string_var "aws_region" "${AWS_REGION_NAME}"
    write_string_var "name" "${INSTANCE_NAME}"
    write_string_var "instance_type" "${INSTANCE_TYPE}"
    write_optional_string_var "key_name" "${KEY_NAME}"
    write_string_var "ami_ssm_parameter" "${AMI_SSM_PARAMETER}"
    printf 'volume_size_gb = %s\n' "${VOLUME_SIZE_GB}"
    write_bool_var "associate_public_ip" "${ASSOCIATE_PUBLIC_IP}"

    write_optional_string_var "vpc_id" "${VPC_ID}"
    write_optional_string_var "subnet_id" "${SUBNET_ID}"
    write_optional_string_var "security_group_id" "${SECURITY_GROUP_ID}"
    write_optional_string_var "ssh_ingress_cidr" "${INGRESS_CIDR}"
    write_string_var "vpc_cidr" "${VPC_CIDR}"
    write_string_var "public_subnet_cidr" "${PUBLIC_SUBNET_CIDR}"
  } > "${TF_VARS_FILE}"
}

aws_key_pair_exists() {
  local output

  if output=$(aws ec2 describe-key-pairs \
    --key-names "${KEY_NAME}" \
    --region "${AWS_REGION_NAME}" 2>&1); then
    return 0
  fi

  if [[ "${output}" == *"InvalidKeyPair.NotFound"* ]]; then
    return 1
  fi

  printf '%s\n' "${output}" >&2
  die "failed to inspect EC2 key pair: ${KEY_NAME}"
}

create_default_key_pair() {
  print_stage "creating default EC2 key pair"
  mkdir -p "${KEY_DIR}"
  if ! aws ec2 create-key-pair \
    --key-name "${KEY_NAME}" \
    --region "${AWS_REGION_NAME}" \
    --query KeyMaterial \
    --output text > "${KEY_FILE}"; then
    rm -f "${KEY_FILE}"
    die "failed to create EC2 key pair: ${KEY_NAME}"
  fi
  chmod 600 "${KEY_FILE}"
}

import_default_key_pair() {
  local public_key_file

  print_stage "importing default EC2 key pair from local private key"
  public_key_file=$(mktemp)
  if ! ssh-keygen -y -f "${KEY_FILE}" > "${public_key_file}"; then
    rm -f "${public_key_file}"
    die "could not derive a public key from ${KEY_FILE}; remove the stale key or pass --key-name and --key-file"
  fi
  if ! aws ec2 import-key-pair \
    --key-name "${KEY_NAME}" \
    --region "${AWS_REGION_NAME}" \
    --public-key-material "fileb://${public_key_file}" >/dev/null; then
    rm -f "${public_key_file}"
    die "failed to import EC2 key pair: ${KEY_NAME}"
  fi
  rm -f "${public_key_file}"
  chmod 600 "${KEY_FILE}"
}

ensure_default_key_pair() {
  [[ "${DEFAULT_KEY_MANAGED}" == "1" && "${DRY_RUN}" == "0" ]] || return 0

  if [[ -f "${KEY_FILE}" ]]; then
    chmod 600 "${KEY_FILE}"
    if aws_key_pair_exists; then
      return 0
    fi
    import_default_key_pair
    return 0
  fi

  if aws_key_pair_exists; then
    die "EC2 key pair ${KEY_NAME} already exists, but local private key is missing: ${KEY_FILE}. AWS cannot re-download private key material; pass --key-name/--key-file, choose another key name, or delete the stale EC2 key pair and rerun."
  fi

  create_default_key_pair
}

terraform_output() {
  terraform -chdir="${TF_DIR}" output -raw "$1"
}

load_outputs() {
  INSTANCE_ID=$(terraform_output instance_id)
  SSH_HOST=$(terraform_output ssh_host 2>/dev/null || true)
}

write_env_var() {
  local name=$1
  local value=$2

  printf '%s=' "${name}"
  printf '%q' "${value}"
  printf '\n'
}

write_connection_metadata() {
  mkdir -p "${STATE_DIR}"
  {
    write_env_var "KEY_NAME" "${KEY_NAME}"
    write_env_var "KEY_FILE" "${KEY_FILE}"
    write_env_var "SSH_USER" "${SSH_USER}"
    write_env_var "REMOTE_DIR" "${REMOTE_DIR}"
    write_env_var "TF_DIR" "${TF_DIR}"
    write_env_var "TF_VARS_FILE" "${TF_VARS_FILE}"
    write_env_var "AWS_REGION_NAME" "${AWS_REGION_NAME}"
    write_env_var "AWS_PROFILE_NAME" "${AWS_PROFILE_NAME}"
    write_env_var "INSTANCE_ID" "${INSTANCE_ID}"
    write_env_var "SSH_HOST" "${SSH_HOST}"
  } > "${CONNECTION_FILE}"
  chmod 600 "${CONNECTION_FILE}"
}

ssh_base_args=()

configure_ssh_args() {
  mkdir -p "${STATE_DIR}"
  ssh_base_args=(
    -i "${KEY_FILE}"
    -o StrictHostKeyChecking=accept-new
    -o UserKnownHostsFile="${STATE_DIR}/known_hosts"
    -o ConnectTimeout=10
    -o ServerAliveInterval=15
  )
}

ssh_remote() {
  # shellcheck disable=SC2029
  ssh "${ssh_base_args[@]}" "${SSH_USER}@${SSH_HOST}" "$@"
}

wait_for_ssh() {
  local deadline
  local last_error=""
  local output

  [[ -n "${SSH_HOST}" ]] || die "Terraform output did not include an SSH host"

  deadline=$((SECONDS + 600))
  while ((SECONDS < deadline)); do
    if output=$(ssh_remote 'echo ready' 2>&1); then
      return 0
    fi
    last_error=${output}
    sleep 10
  done

  printf 'SSH did not become reachable before timeout.\n' >&2
  printf '  Host: %s@%s\n' "${SSH_USER}" "${SSH_HOST}" >&2
  printf '  Configured ingress CIDR: %s\n' "${INGRESS_CIDR:-unknown}" >&2
  if [[ -n "${last_error}" ]]; then
    printf '  Last ssh error: %s\n' "${last_error}" >&2
  fi
  printf 'If the last error is an operation timeout, the most likely cause is source NAT mismatch: the HTTPS public-IP discovery used for the default /32 rule can differ from the IP AWS sees for SSH.\n' >&2
  printf 'Retry with --ingress-cidr set to the observed SSH NAT range or run from a network with stable egress IP.\n' >&2

  die "timed out waiting for SSH on ${SSH_USER}@${SSH_HOST}"
}

sync_repo() {
  ssh_remote "rm -rf ~/${REMOTE_DIR} && mkdir -p ~/${REMOTE_DIR}"

  tar \
    --no-xattrs \
    --exclude='.aws-gpu' \
    --exclude='.git' \
    --exclude='.mypy_cache' \
    --exclude='.pytest_cache' \
    --exclude='.ruff_cache' \
    --exclude='.terraform' \
    --exclude='.venv' \
    --exclude='*.tfvars' \
    --exclude='*.tfvars.json' \
    --exclude='*.tfstate' \
    --exclude='*.tfstate.*' \
    --exclude='*.tfplan' \
    --exclude='tfplan' \
    --exclude='benchmarks/results' \
    --exclude='experiments/results' \
    --exclude='profiling/**/captures' \
    --exclude='profiling/**/raw' \
    -czf - \
    -C "${REPO_ROOT}" . \
    | ssh_remote "tar -xzf - -C \$HOME/${REMOTE_DIR}"
}

bootstrap_remote() {
  ssh_remote "cd ~/${REMOTE_DIR} && \
    if ! command -v uv >/dev/null 2>&1; then uv_installer=\$(mktemp) && curl -LsSf https://astral.sh/uv/install.sh -o \"\$uv_installer\" && sh \"\$uv_installer\" && rm -f \"\$uv_installer\"; fi && \
    export PATH=\"\$HOME/.local/bin:\$PATH\" && \
    uv sync --group dev --extra gpu && \
    uv run gpu-info && \
    uv run benchmark-matrix --include-vector-add-sweep --include-reduction-sweep --dry-run"
}

network_label() {
  if [[ -n "${SUBNET_ID}" ]]; then
    printf 'existing subnet %s' "${SUBNET_ID}"
  elif [[ -n "${VPC_ID}" ]]; then
    printf 'first subnet in existing VPC %s' "${VPC_ID}"
  else
    printf 'disposable VPC %s, public subnet %s' "${VPC_CIDR}" "${PUBLIC_SUBNET_CIDR}"
  fi
}

bootstrap_label() {
  if [[ "${SKIP_BOOTSTRAP}" == "1" ]]; then
    printf 'disabled'
  else
    printf 'enabled'
  fi
}

print_teardown_command() {
  local -a down_cmd
  down_cmd=("./scripts/down")

  if [[ -n "${AWS_PROFILE_NAME}" ]]; then
    down_cmd+=(--profile "${AWS_PROFILE_NAME}")
  fi
  if [[ "${TF_DIR}" != "${REPO_ROOT}/infra/env/aws-gpu" ]]; then
    down_cmd+=(--tf-dir "${TF_DIR}")
  fi
  if [[ "${TF_VARS_FILE_EXPLICIT}" == "1" ]]; then
    down_cmd+=(--tf-vars-file "${TF_VARS_FILE}")
  fi

  printf '  Tear down:'
  printf ' %q' "${down_cmd[@]}"
  printf '\n'
}

print_launch_summary() {
  printf '\nLaunch configuration:\n'
  if [[ "${DRY_RUN}" == "1" ]]; then
    printf '  Mode: dry run; no Terraform commands will run\n'
  fi
  printf '  Region: %s\n' "${AWS_REGION_NAME}"
  if [[ -n "${AWS_PROFILE_NAME}" ]]; then
    printf '  AWS profile: %s\n' "${AWS_PROFILE_NAME}"
  fi
  printf '  Instance: %s (%s GiB root volume)\n' "${INSTANCE_TYPE}" "${VOLUME_SIZE_GB}"
  printf '  Network: %s\n' "$(network_label)"
  if [[ -n "${SECURITY_GROUP_ID}" ]]; then
    printf '  Security group: %s\n' "${SECURITY_GROUP_ID}"
  elif ssh_access_requested; then
    if [[ -n "${INGRESS_CIDR}" ]]; then
      printf '  SSH ingress: %s\n' "${INGRESS_CIDR}"
    elif [[ "${DRY_RUN}" == "1" ]]; then
      printf '  SSH ingress: auto-discovered public IP /32\n'
    else
      printf '  SSH ingress: pending public IP discovery\n'
    fi
  else
    printf '  SSH ingress: closed by default; no EC2 key pair requested\n'
  fi
  if ssh_access_requested; then
    if [[ "${DEFAULT_KEY_MANAGED}" == "1" ]]; then
      printf '  EC2 key pair: %s (managed default)\n' "${KEY_NAME}"
    else
      printf '  EC2 key pair: %s\n' "${KEY_NAME}"
    fi
    printf '  SSH key file: %s\n' "${KEY_FILE}"
  fi
  printf '  Bootstrap: %s\n' "$(bootstrap_label)"
  printf '  Terraform: %s\n' "${TF_DIR}"
  printf '  Variables: %s\n' "${TF_VARS_FILE}"
}

print_ready() {
  printf '\nReady:\n'
  printf '  Instance: %s (%s)\n' "${INSTANCE_ID}" "${INSTANCE_TYPE}"
  printf '  Region: %s\n' "${AWS_REGION_NAME}"
  printf '  Terraform: %s\n' "${TF_DIR}"
  printf '  Variables: %s\n' "${TF_VARS_FILE}"

  if [[ -n "${SSH_HOST}" && -n "${KEY_FILE}" ]]; then
    printf '  SSH: ssh -i %q %s@%s\n' "${KEY_FILE}" "${SSH_USER}" "${SSH_HOST}"
    printf '  Repo: ~/%s\n' "${REMOTE_DIR}"
    printf '  Connection metadata: %s\n' "${CONNECTION_FILE}"
    printf '  Benchmark: ./scripts/benchmark --run-id <run-id>\n'
  elif [[ -n "${SSH_HOST}" && -n "${KEY_NAME}" ]]; then
    printf '  SSH host: %s@%s\n' "${SSH_USER}" "${SSH_HOST}"
    printf '  SSH key: use the private key for EC2 key pair %s\n' "${KEY_NAME}"
  elif [[ -n "${SSH_HOST}" ]]; then
    printf '  SSH access: disabled; relaunch with --key-name and --key-file to bootstrap over SSH.\n'
  else
    printf '  SSH host: no reachable host recorded; check private connectivity for the selected subnet.\n'
  fi

  print_teardown_command
}

main() {
  parse_args "$@"
  resolve_default_key
  validate_inputs
  check_prereqs
  if [[ -n "${AWS_PROFILE_NAME}" ]]; then
    export AWS_PROFILE="${AWS_PROFILE_NAME}"
  fi

  ensure_default_key_pair

  print_stage "resolving SSH ingress input"
  resolve_ingress_cidr

  print_stage "writing local Terraform variables"
  write_tfvars
  print_launch_summary

  if [[ "${DRY_RUN}" == "1" ]]; then
    print_stage "dry run complete"
    return 0
  fi

  print_stage "terraform init"
  terraform -chdir="${TF_DIR}" init -input=false

  print_stage "terraform apply"
  local -a apply_args
  apply_args=(-auto-approve -input=false)
  if [[ "${TF_VARS_FILE_EXPLICIT}" == "1" ]]; then
    apply_args+=("-var-file=${TF_VARS_FILE}")
  fi
  terraform -chdir="${TF_DIR}" apply "${apply_args[@]}"

  load_outputs
  write_connection_metadata

  if [[ "${SKIP_BOOTSTRAP}" == "0" ]]; then
    print_stage "syncing repo and bootstrapping GPU benchmark environment"
    configure_ssh_args
    wait_for_ssh
    sync_repo
    bootstrap_remote
  else
    print_stage "skipping SSH bootstrap"
  fi

  print_ready
}

main "$@"
