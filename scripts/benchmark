#!/usr/bin/env bash

set -Eeuo pipefail

SCRIPT_DIR=$(cd -- "$(dirname "${BASH_SOURCE[0]}")" && pwd)
REPO_ROOT=$(cd -- "${SCRIPT_DIR}/.." && pwd)

die() {
  printf 'error: %s\n' "$*" >&2
  exit 1
}

print_stage() {
  printf '==> %s\n' "$1"
}

require_commands() {
  local missing=()
  local command_name

  for command_name in "$@"; do
    if ! command -v "${command_name}" >/dev/null 2>&1; then
      missing+=("${command_name}")
    fi
  done

  if ((${#missing[@]} > 0)); then
    die "missing required command(s): ${missing[*]}"
  fi
}

require_value() {
  local option=$1
  local value=${2:-}

  [[ -n "${value}" && "${value}" != --* ]] || die "${option} requires a value"
}

expand_path() {
  local path=$1
  local home_prefix

  printf -v home_prefix '%b' '\x7e/'

  if [[ "${path:0:2}" == "${home_prefix}" ]]; then
    printf '%s/%s\n' "${HOME}" "${path#~/}"
    return
  fi

  printf '%s\n' "${path}"
}

absolute_path() {
  local path
  path=$(expand_path "$1")

  if [[ "${path}" == /* ]]; then
    printf '%s\n' "${path}"
  else
    printf '%s/%s\n' "$(pwd -P)" "${path}"
  fi
}

STATE_DIR=$(absolute_path "${CUDA_KERNEL_LAB_AWS_STATE_DIR:-${REPO_ROOT}/.aws-gpu}")
CONNECTION_FILE=$(absolute_path "${CUDA_KERNEL_LAB_CONNECTION_FILE:-${STATE_DIR}/connection.env}")
TF_DIR=$(absolute_path "${CUDA_KERNEL_LAB_TF_DIR:-${REPO_ROOT}/infra/env/aws-gpu}")
TF_VARS_FILE="${CUDA_KERNEL_LAB_TF_VARS_FILE:-}"

AWS_PROFILE_NAME="${AWS_PROFILE:-}"
AWS_PROFILE_ENV_SET=0
if [[ -n "${AWS_PROFILE:-}" ]]; then
  AWS_PROFILE_ENV_SET=1
fi
RUN_ID=""
KEY_FILE=""
SSH_USER="ubuntu"
REMOTE_DIR="cuda-kernel-lab"
OUTPUT_ROOT="experiments/results/aws-ec2"
REPORT_ROOT="experiments/reports/aws-ec2"
INCLUDE_MATMUL=0
INCLUDE_MATMUL_SWEEP=0
INCLUDE_RMSNORM_SHAPE_SWEEP=0
INCLUDE_ATTENTION_BASELINE=0
INCLUDE_DECODE_STEP=0
PROFILE=0
DRY_RUN=0

KEY_FILE_SET=0
SSH_USER_SET=0
REMOTE_DIR_SET=0
TF_DIR_SET=0
TF_VARS_FILE_SET=0
AWS_PROFILE_SET=0

RESULT_DIR=""
REPORT_PATH=""
PROFILE_RESULT_DIR=""
PROFILE_EXPORT_DIR=""
PROFILE_REPORT_DIR=""
GIT_COMMIT=""
GIT_DIRTY="unknown"
SSH_HOST=""
INSTANCE_ID=""

ssh_base_args=()

usage() {
  cat <<EOF
Usage:
  ./scripts/benchmark [options]

Runs the benchmark matrix on the GPU host created by ./scripts/up, copies JSONL
results and Markdown reports back locally, and leaves the host running for more
experiments.

Options:
  --run-id <id>             Result run id. Default: UTC timestamp.
  --key-file <path>         SSH private key. Default: .aws-gpu/connection.env.
  --profile <name>          AWS CLI profile used by Terraform output reads.
  --include-matmul          Include the tiled matmul progression in the matrix.
  --include-matmul-sweep    Include the float16 matmul tile and launch strategy sweep.
  --include-rmsnorm-shape-sweep
                            Include the focused RMSNorm hidden-size and batch-size sweep.
  --include-attention-baseline
                            Include the PyTorch contiguous KV-cache decode-attention baseline.
  --include-decode-step     Include synthetic decode-step eager vs CUDA Graph replay modes.
  --with-profiling          Capture focused Nsight Compute CSV and Markdown summaries.
  --output-root <path>      Raw JSONL root. Default: ${OUTPUT_ROOT}
  --report-root <path>      Markdown report root. Default: ${REPORT_ROOT}
  --ssh-user <name>         SSH user. Default: ${SSH_USER}
  --remote-dir <path>       Remote repo directory. Default: ${REMOTE_DIR}
  --tf-dir <path>           Terraform environment. Default: ${TF_DIR}
  --tf-vars-file <path>     Terraform variable file label from ./scripts/up.
  --connection-file <path>  Connection metadata file. Default: ${CONNECTION_FILE}
  --dry-run                 Print the planned benchmark without SSH or Terraform.

Examples:
  ./scripts/up
  ./scripts/benchmark --run-id 2026-05-21-a10g-baseline
  ./scripts/benchmark --run-id 2026-05-21-a10g-profile --with-profiling
  ./scripts/benchmark --run-id 2026-05-21-a10g-matmul --include-matmul-sweep
  ./scripts/down
EOF
}

parse_args() {
  while (($# > 0)); do
    case "$1" in
      -h|--help)
        usage
        exit 0
        ;;
      --run-id)
        require_value "$1" "${2:-}"
        RUN_ID=${2:-}
        shift 2
        ;;
      --key-file)
        require_value "$1" "${2:-}"
        KEY_FILE=$(absolute_path "${2:-}")
        KEY_FILE_SET=1
        shift 2
        ;;
      --profile)
        require_value "$1" "${2:-}"
        AWS_PROFILE_NAME=${2:-}
        AWS_PROFILE_SET=1
        shift 2
        ;;
      --include-matmul)
        INCLUDE_MATMUL=1
        shift
        ;;
      --include-matmul-sweep)
        INCLUDE_MATMUL_SWEEP=1
        shift
        ;;
      --include-rmsnorm-shape-sweep)
        INCLUDE_RMSNORM_SHAPE_SWEEP=1
        shift
        ;;
      --include-attention-baseline)
        INCLUDE_ATTENTION_BASELINE=1
        shift
        ;;
      --include-decode-step)
        INCLUDE_DECODE_STEP=1
        shift
        ;;
      --with-profiling)
        PROFILE=1
        shift
        ;;
      --output-root)
        require_value "$1" "${2:-}"
        OUTPUT_ROOT=${2:-}
        shift 2
        ;;
      --report-root)
        require_value "$1" "${2:-}"
        REPORT_ROOT=${2:-}
        shift 2
        ;;
      --ssh-user)
        require_value "$1" "${2:-}"
        SSH_USER=${2:-}
        SSH_USER_SET=1
        shift 2
        ;;
      --remote-dir)
        require_value "$1" "${2:-}"
        REMOTE_DIR=${2:-}
        REMOTE_DIR_SET=1
        shift 2
        ;;
      --tf-dir)
        require_value "$1" "${2:-}"
        TF_DIR=$(absolute_path "${2:-}")
        TF_DIR_SET=1
        shift 2
        ;;
      --tf-vars-file)
        require_value "$1" "${2:-}"
        TF_VARS_FILE=$(absolute_path "${2:-}")
        TF_VARS_FILE_SET=1
        shift 2
        ;;
      --connection-file)
        require_value "$1" "${2:-}"
        CONNECTION_FILE=$(absolute_path "${2:-}")
        shift 2
        ;;
      --dry-run)
        DRY_RUN=1
        shift
        ;;
      *)
        die "unknown argument: $1"
        ;;
    esac
  done
}

load_connection_metadata() {
  local cli_aws_profile_name=${AWS_PROFILE_NAME}
  local cli_key_file=${KEY_FILE}
  local cli_remote_dir=${REMOTE_DIR}
  local cli_ssh_user=${SSH_USER}
  local cli_tf_dir=${TF_DIR}
  local cli_tf_vars_file=${TF_VARS_FILE}

  if [[ -f "${CONNECTION_FILE}" ]]; then
    # shellcheck disable=SC1090
    source "${CONNECTION_FILE}"
  fi

  if [[ "${KEY_FILE_SET}" == "1" ]]; then
    KEY_FILE=${cli_key_file}
  fi
  if [[ "${SSH_USER_SET}" == "1" ]]; then
    SSH_USER=${cli_ssh_user}
  fi
  if [[ "${REMOTE_DIR_SET}" == "1" ]]; then
    REMOTE_DIR=${cli_remote_dir}
  fi
  if [[ "${TF_DIR_SET}" == "1" ]]; then
    TF_DIR=${cli_tf_dir}
  fi
  if [[ "${TF_VARS_FILE_SET}" == "1" ]]; then
    TF_VARS_FILE=${cli_tf_vars_file}
  fi
  if [[ "${AWS_PROFILE_SET}" == "1" || "${AWS_PROFILE_ENV_SET}" == "1" ]]; then
    AWS_PROFILE_NAME=${cli_aws_profile_name}
  fi
}

validate_slug() {
  local label=$1
  local value=$2

  [[ "${value}" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || {
    die "${label} must use only letters, numbers, dots, underscores, and dashes"
  }
}

validate_relative_path() {
  local label=$1
  local value=$2

  [[ "${value}" =~ ^[A-Za-z0-9._/-]+$ ]] || die "${label} contains unsafe characters"
  [[ "${value}" != /* && "${value}" != *..* ]] || {
    die "${label} must be a relative path without '..'"
  }
  [[ "${value}" != "." && "${value}" != .* && "${value}" != */.* ]] || {
    die "${label} must not target hidden or current-directory paths"
  }
}

resolve_defaults() {
  if [[ -z "${RUN_ID}" ]]; then
    RUN_ID=$(date -u +%Y%m%dT%H%M%SZ)
  fi
  validate_slug "--run-id" "${RUN_ID}"

  RESULT_DIR="${OUTPUT_ROOT}/${RUN_ID}"
  REPORT_PATH="${REPORT_ROOT}/${RUN_ID}.md"
  PROFILE_RESULT_DIR="${OUTPUT_ROOT}/${RUN_ID}-profiled"
  PROFILE_EXPORT_DIR="profiling/nsight_compute/${RUN_ID}"
  PROFILE_REPORT_DIR="profiling/reports/${RUN_ID}"
}

validate_inputs() {
  [[ -d "${TF_DIR}" ]] || die "Terraform directory does not exist: ${TF_DIR}"
  [[ "${SSH_USER}" =~ ^[A-Za-z_][A-Za-z0-9_.-]*[$]?$ ]] || die "--ssh-user contains unsafe characters"
  validate_relative_path "--remote-dir" "${REMOTE_DIR}"
  validate_relative_path "--output-root" "${OUTPUT_ROOT}"
  validate_relative_path "--report-root" "${REPORT_ROOT}"
  validate_relative_path "profile export directory" "${PROFILE_EXPORT_DIR}"
  validate_relative_path "profile report directory" "${PROFILE_REPORT_DIR}"

  if [[ -z "${KEY_FILE}" ]]; then
    die "missing SSH key file; run ./scripts/up first or pass --key-file"
  fi
  if [[ "${DRY_RUN}" == "0" && ! -f "${KEY_FILE}" ]]; then
    die "SSH key file does not exist: ${KEY_FILE}"
  fi

  if [[ "${DRY_RUN}" == "0" ]]; then
    [[ ! -e "${REPO_ROOT}/${RESULT_DIR}" ]] || die "result directory already exists: ${RESULT_DIR}"
    [[ ! -e "${REPO_ROOT}/${REPORT_PATH}" ]] || die "report already exists: ${REPORT_PATH}"
    if [[ "${PROFILE}" == "1" ]]; then
      [[ ! -e "${REPO_ROOT}/${PROFILE_RESULT_DIR}" ]] || {
        die "profile result directory already exists: ${PROFILE_RESULT_DIR}"
      }
      [[ ! -e "${REPO_ROOT}/${PROFILE_EXPORT_DIR}" ]] || {
        die "profile export directory already exists: ${PROFILE_EXPORT_DIR}"
      }
      [[ ! -e "${REPO_ROOT}/${PROFILE_REPORT_DIR}" ]] || {
        die "profile report directory already exists: ${PROFILE_REPORT_DIR}"
      }
    fi
  fi
}

collect_source_metadata() {
  GIT_COMMIT=$(git -C "${REPO_ROOT}" rev-parse HEAD 2>/dev/null || true)

  local status
  if status=$(git -C "${REPO_ROOT}" status --short 2>/dev/null); then
    if [[ -n "${status}" ]]; then
      GIT_DIRTY="true"
    else
      GIT_DIRTY="false"
    fi
  fi
}

load_outputs() {
  if ! SSH_HOST=$(terraform -chdir="${TF_DIR}" output -raw ssh_host 2>/dev/null); then
    die "could not read Terraform ssh_host output; run ./scripts/up first"
  fi
  INSTANCE_ID=$(terraform -chdir="${TF_DIR}" output -raw instance_id 2>/dev/null || true)
}

print_command() {
  printf '  '
  printf '%q ' "$@"
  printf '\n'
}

remote_benchmark_command() {
  local command

  command="cd ~/${REMOTE_DIR}"
  command+=" && export PATH=\"\$HOME/.local/bin:\$PATH\""
  if [[ -n "${GIT_COMMIT}" ]]; then
    command+=" && export CUDA_KERNEL_LAB_GIT_COMMIT=${GIT_COMMIT}"
  fi
  command+=" && export CUDA_KERNEL_LAB_GIT_DIRTY=${GIT_DIRTY}"
  command+=" && uv run benchmark-matrix --output-dir ${RESULT_DIR}"
  command+=" --include-vector-add-sweep --include-reduction-sweep"
  if [[ "${INCLUDE_MATMUL}" == "1" ]]; then
    command+=" --include-matmul"
  fi
  if [[ "${INCLUDE_MATMUL_SWEEP}" == "1" ]]; then
    command+=" --include-matmul-sweep --matmul-input-precision tf32"
  fi
  if [[ "${INCLUDE_RMSNORM_SHAPE_SWEEP}" == "1" ]]; then
    command+=" --include-rmsnorm-shape-sweep"
  fi
  if [[ "${INCLUDE_ATTENTION_BASELINE}" == "1" ]]; then
    command+=" --include-attention-baseline"
  fi
  if [[ "${INCLUDE_DECODE_STEP}" == "1" ]]; then
    command+=" --include-decode-step"
  fi
  command+=" && uv run benchmark-report --input-dir ${RESULT_DIR} --output ${REPORT_PATH}"

  printf '%s\n' "${command}"
}

profile_benchmark_command() {
  local target=$1

  case "${target}" in
    memory-vector-add-float32)
      printf '%s\n' \
        "uv run benchmark-memory --backend triton --device cuda --op vector_add --numel 16777216 --dtype float32 --block-size 1024 --warmup 5 --iterations 10 --skip-correctness --output ${PROFILE_RESULT_DIR}/memory-vector-add-float32.jsonl"
      ;;
    memory-reduction-iterative-float32)
      printf '%s\n' \
        "uv run benchmark-memory --backend triton --device cuda --op reduction_sum --numel 16777216 --dtype float32 --block-size 1024 --reduction-strategy iterative --warmup 5 --iterations 10 --skip-correctness --output ${PROFILE_RESULT_DIR}/memory-reduction-iterative-float32.jsonl"
      ;;
    memory-reduction-two-pass-float32)
      printf '%s\n' \
        "uv run benchmark-memory --backend triton --device cuda --op reduction_sum --numel 16777216 --dtype float32 --block-size 1024 --reduction-strategy two_pass --warmup 5 --iterations 10 --skip-correctness --output ${PROFILE_RESULT_DIR}/memory-reduction-two-pass-float32.jsonl"
      ;;
    norms-rmsnorm-float16)
      printf '%s\n' \
        "uv run benchmark-norms --backend triton --device cuda --op rmsnorm --rows 4096 --cols 4096 --dtype float16 --warmup 5 --iterations 10 --skip-correctness --output ${PROFILE_RESULT_DIR}/norms-rmsnorm-float16.jsonl"
      ;;
    matmul-tiled-float16)
      printf '%s\n' \
        "uv run benchmark-matmul --backend triton --device cuda --m 1024 --n 1024 --k 1024 --dtype float16 --block-m 64 --block-n 64 --block-k 32 --num-warps 4 --num-stages 3 --input-precision tf32 --warmup 5 --iterations 10 --skip-correctness --output ${PROFILE_RESULT_DIR}/matmul-tiled-float16.jsonl"
      ;;
    decode-step-naive-eager-float16)
      printf '%s\n' \
        "uv run benchmark-decode-step --mode naive-eager --device cuda --dtype float16 --warmup 5 --iterations 10 --skip-correctness --output ${PROFILE_RESULT_DIR}/decode-step-naive-eager-float16.jsonl"
      ;;
    decode-step-fused-eager-float16)
      printf '%s\n' \
        "uv run benchmark-decode-step --mode fused-eager --device cuda --dtype float16 --warmup 5 --iterations 10 --skip-correctness --output ${PROFILE_RESULT_DIR}/decode-step-fused-eager-float16.jsonl"
      ;;
    decode-step-naive-graph-float16)
      printf '%s\n' \
        "uv run benchmark-decode-step --mode naive-graph --device cuda --dtype float16 --warmup 5 --iterations 10 --skip-correctness --output ${PROFILE_RESULT_DIR}/decode-step-naive-graph-float16.jsonl"
      ;;
    decode-step-fused-graph-float16)
      printf '%s\n' \
        "uv run benchmark-decode-step --mode fused-graph --device cuda --dtype float16 --warmup 5 --iterations 10 --skip-correctness --output ${PROFILE_RESULT_DIR}/decode-step-fused-graph-float16.jsonl"
      ;;
    *)
      die "unknown profile target: ${target}"
      ;;
  esac
}

profile_title() {
  local target=$1

  case "${target}" in
    memory-vector-add-float32)
      printf '%s\n' "A10G vector_add float32 profile"
      ;;
    memory-reduction-iterative-float32)
      printf '%s\n' "A10G reduction_sum iterative float32 profile"
      ;;
    memory-reduction-two-pass-float32)
      printf '%s\n' "A10G reduction_sum two-pass float32 profile"
      ;;
    norms-rmsnorm-float16)
      printf '%s\n' "A10G RMSNorm float16 profile"
      ;;
    matmul-tiled-float16)
      printf '%s\n' "A10G matmul float16 tiled-dot profile"
      ;;
    decode-step-naive-eager-float16)
      printf '%s\n' "A10G decode step naive eager float16 profile"
      ;;
    decode-step-fused-eager-float16)
      printf '%s\n' "A10G decode step fused eager float16 profile"
      ;;
    decode-step-naive-graph-float16)
      printf '%s\n' "A10G decode step naive CUDA Graph float16 profile"
      ;;
    decode-step-fused-graph-float16)
      printf '%s\n' "A10G decode step fused CUDA Graph float16 profile"
      ;;
    *)
      die "unknown profile target: ${target}"
      ;;
  esac
}

profile_operation() {
  local target=$1

  case "${target}" in
    memory-vector-add-float32)
      printf '%s\n' "vector_add"
      ;;
    memory-reduction-iterative-float32|memory-reduction-two-pass-float32)
      printf '%s\n' "reduction_sum"
      ;;
    norms-rmsnorm-float16)
      printf '%s\n' "rmsnorm"
      ;;
    matmul-tiled-float16)
      printf '%s\n' "matmul"
      ;;
    decode-step-naive-eager-float16|decode-step-fused-eager-float16|decode-step-naive-graph-float16|decode-step-fused-graph-float16)
      printf '%s\n' "decode_step"
      ;;
    *)
      die "unknown profile target: ${target}"
      ;;
  esac
}

profile_strategy() {
  local target=$1

  case "${target}" in
    memory-vector-add-float32)
      printf '%s\n' "triton-block-size"
      ;;
    memory-reduction-iterative-float32)
      printf '%s\n' "triton-reduction-iterative"
      ;;
    memory-reduction-two-pass-float32)
      printf '%s\n' "triton-reduction-two-pass"
      ;;
    norms-rmsnorm-float16)
      printf '%s\n' "triton-fused-rmsnorm"
      ;;
    matmul-tiled-float16)
      printf '%s\n' "triton-tiled-dot-block-64x64x32-warps-4-stages-3"
      ;;
    decode-step-naive-eager-float16)
      printf '%s\n' "naive-eager"
      ;;
    decode-step-fused-eager-float16)
      printf '%s\n' "fused-eager"
      ;;
    decode-step-naive-graph-float16)
      printf '%s\n' "naive-graph"
      ;;
    decode-step-fused-graph-float16)
      printf '%s\n' "fused-graph"
      ;;
    *)
      die "unknown profile target: ${target}"
      ;;
  esac
}

profile_launch_skip() {
  local target=$1

  case "${target}" in
    memory-reduction-two-pass-float32)
      printf '%s\n' "10"
      ;;
    memory-vector-add-float32|memory-reduction-iterative-float32|norms-rmsnorm-float16|matmul-tiled-float16|decode-step-naive-eager-float16|decode-step-fused-eager-float16|decode-step-naive-graph-float16|decode-step-fused-graph-float16)
      printf '%s\n' "5"
      ;;
    *)
      die "unknown profile target: ${target}"
      ;;
  esac
}

profile_case_command() {
  local target=$1
  local benchmark_cmd
  local benchmark_log
  local benchmark_with_log
  local csv_path
  local stderr_path
  local report_path
  local operation
  local strategy
  local title
  local launch_skip
  local quoted_benchmark_cmd
  local quoted_benchmark_with_log
  local quoted_title

  benchmark_cmd=$(profile_benchmark_command "${target}")
  benchmark_log="${PROFILE_EXPORT_DIR}/${target}.benchmark.txt"
  benchmark_with_log="${benchmark_cmd} > ${benchmark_log}"
  csv_path="${PROFILE_EXPORT_DIR}/${target}.csv"
  stderr_path="${PROFILE_EXPORT_DIR}/${target}.stderr.txt"
  report_path="${PROFILE_REPORT_DIR}/${target}.md"
  operation=$(profile_operation "${target}")
  strategy=$(profile_strategy "${target}")
  title=$(profile_title "${target}")
  launch_skip=$(profile_launch_skip "${target}")

  printf -v quoted_benchmark_cmd '%q' "${benchmark_cmd}"
  printf -v quoted_benchmark_with_log '%q' "${benchmark_with_log}"
  printf -v quoted_title '%q' "${title}"

  printf '%s' "printf '\\n==> profiling ${target}\\n'"
  printf '%s' " && if ( sudo -n env HOME=\"\$HOME\" PATH=\"\$PATH\" \"\${ncu_bin}\" --set full --target-processes all --launch-skip ${launch_skip} --launch-count 1 --csv --page raw bash -lc ${quoted_benchmark_with_log} > ${csv_path} 2> ${stderr_path} || sudo -n env HOME=\"\$HOME\" PATH=\"\$PATH\" \"\${ncu_bin}\" --set full --target-processes all --launch-skip ${launch_skip} --launch-count 1 --csv bash -lc ${quoted_benchmark_with_log} > ${csv_path} 2>> ${stderr_path} ); then"
  printf '%s' " uv run nsight-summary --input ${csv_path} --output ${report_path} --title ${quoted_title} --benchmark-command ${quoted_benchmark_cmd} --result-jsonl ${PROFILE_RESULT_DIR}/${target}.jsonl --operation ${operation} --strategy ${strategy};"
  printf '%s' " else printf '# %s\\n\\nStatus: profile command failed\\n\\n- Nsight CSV: \`%s\`\\n- Nsight stderr: \`%s\`\\n- Benchmark log: \`%s\`\\n' ${quoted_title} ${csv_path} ${stderr_path} ${benchmark_log} > ${report_path}; cat ${stderr_path} >&2; false; fi"
}

remote_profile_command() {
  local command
  local target
  local targets

  command="cd ~/${REMOTE_DIR}"
  command+=" && export PATH=\"\$HOME/.local/bin:\$PATH\""
  if [[ -n "${GIT_COMMIT}" ]]; then
    command+=" && export CUDA_KERNEL_LAB_GIT_COMMIT=${GIT_COMMIT}"
  fi
  command+=" && export CUDA_KERNEL_LAB_GIT_DIRTY=${GIT_DIRTY}"
  command+=" && mkdir -p ${PROFILE_RESULT_DIR} ${PROFILE_EXPORT_DIR} ${PROFILE_REPORT_DIR}"
  command+=" && profile_status=0"
  command+=" && ncu_bin=\$(command -v ncu || true)"
  command+="; if [ -z \"\${ncu_bin}\" ]; then printf '# Nsight Compute Profile\\n\\nStatus: ncu was not found on the remote host.\\n' > ${PROFILE_REPORT_DIR}/profile-error.md; exit 1; fi"
  command+="; if ! sudo -n true >/dev/null 2>&1; then printf '# Nsight Compute Profile\\n\\nStatus: passwordless sudo is required to access NVIDIA performance counters.\\n' > ${PROFILE_REPORT_DIR}/profile-error.md; exit 1; fi"

  targets=(
    memory-vector-add-float32
    memory-reduction-iterative-float32
    memory-reduction-two-pass-float32
    norms-rmsnorm-float16
    matmul-tiled-float16
  )
  if [[ "${INCLUDE_DECODE_STEP}" == "1" ]]; then
    targets+=(
      decode-step-naive-eager-float16
      decode-step-fused-eager-float16
      decode-step-naive-graph-float16
      decode-step-fused-graph-float16
    )
  fi

  for target in "${targets[@]}"; do
    command+="; $(profile_case_command "${target}") || profile_status=1"
  done
  command+="; exit \${profile_status}"

  printf '%s\n' "${command}"
}

print_plan() {
  printf '\nBenchmark plan:\n'
  if [[ "${DRY_RUN}" == "1" ]]; then
    printf '  Mode: dry run; no SSH or Terraform commands will run\n'
  fi
  printf '  Run id: %s\n' "${RUN_ID}"
  printf '  Terraform: %s\n' "${TF_DIR}"
  if [[ -n "${TF_VARS_FILE}" ]]; then
    printf '  Terraform variables: %s\n' "${TF_VARS_FILE}"
  fi
  if [[ -f "${CONNECTION_FILE}" ]]; then
    printf '  Connection metadata: %s\n' "${CONNECTION_FILE}"
  fi
  if [[ -n "${AWS_PROFILE_NAME}" ]]; then
    printf '  AWS profile: %s\n' "${AWS_PROFILE_NAME}"
  fi
  printf '  SSH: %s@%s\n' "${SSH_USER}" "${SSH_HOST:-<terraform ssh_host>}"
  printf '  SSH key file: %s\n' "${KEY_FILE}"
  printf '  Remote repo: ~/%s\n' "${REMOTE_DIR}"
  printf '  Raw results: %s\n' "${RESULT_DIR}"
  printf '  Report: %s\n' "${REPORT_PATH}"
  if [[ "${INCLUDE_MATMUL_SWEEP}" == "1" ]]; then
    printf '  Matmul sweep: enabled\n'
  elif [[ "${INCLUDE_MATMUL}" == "1" ]]; then
    printf '  Matmul baseline: enabled\n'
  fi
  if [[ "${INCLUDE_RMSNORM_SHAPE_SWEEP}" == "1" ]]; then
    printf '  RMSNorm shape sweep: enabled\n'
  fi
  if [[ "${INCLUDE_ATTENTION_BASELINE}" == "1" ]]; then
    printf '  Attention baseline: enabled\n'
  fi
  if [[ "${INCLUDE_DECODE_STEP}" == "1" ]]; then
    printf '  Decode-step graph benchmark: enabled\n'
  fi
  if [[ "${PROFILE}" == "1" ]]; then
    printf '  Profile JSONL: %s\n' "${PROFILE_RESULT_DIR}"
    printf '  Nsight Compute exports: %s\n' "${PROFILE_EXPORT_DIR}"
    printf '  Profile summaries: %s\n' "${PROFILE_REPORT_DIR}"
  fi
  printf '  Source git commit: %s\n' "${GIT_COMMIT:-unknown}"
  printf '  Source git dirty: %s\n' "${GIT_DIRTY}"

  if [[ "${DRY_RUN}" == "1" ]]; then
    printf '\nCommands:\n'
    print_command terraform -chdir="${TF_DIR}" output -raw ssh_host
    printf '  ssh %s@<host> %q\n' "${SSH_USER}" "$(remote_benchmark_command)"
    if [[ "${PROFILE}" == "1" ]]; then
      printf '  ssh %s@<host> %q\n' "${SSH_USER}" "$(remote_profile_command)"
    fi
  fi
}

configure_ssh_args() {
  mkdir -p "${STATE_DIR}"
  ssh_base_args=(
    -i "${KEY_FILE}"
    -o StrictHostKeyChecking=accept-new
    -o UserKnownHostsFile="${STATE_DIR}/known_hosts"
    -o ConnectTimeout=10
    -o ServerAliveInterval=15
  )
}

ssh_remote() {
  # shellcheck disable=SC2029
  ssh "${ssh_base_args[@]}" "${SSH_USER}@${SSH_HOST}" "$@"
}

run_remote_benchmark() {
  print_stage "running benchmark matrix"
  ssh_remote "$(remote_benchmark_command)"
}

run_remote_profile() {
  [[ "${PROFILE}" == "1" ]] || return 0

  print_stage "running focused Nsight Compute profiles"
  ssh_remote "$(remote_profile_command)"
}

pull_benchmark_artifacts() {
  print_stage "copying benchmark artifacts back"
  mkdir -p "${REPO_ROOT}/${OUTPUT_ROOT}" "${REPO_ROOT}/${REPORT_ROOT}"
  ssh_remote "cd ~/${REMOTE_DIR} && tar -czf - ${RESULT_DIR} ${REPORT_PATH}" \
    | tar -xzf - -C "${REPO_ROOT}"
}

pull_profile_artifacts() {
  [[ "${PROFILE}" == "1" ]] || return 0

  print_stage "copying profiler artifacts back"
  mkdir -p "${REPO_ROOT}/${OUTPUT_ROOT}" "${REPO_ROOT}/profiling/nsight_compute" \
    "${REPO_ROOT}/profiling/reports"
  ssh_remote \
    "cd ~/${REMOTE_DIR} && tar -czf - ${PROFILE_RESULT_DIR} ${PROFILE_EXPORT_DIR} ${PROFILE_REPORT_DIR}" \
    | tar -xzf - -C "${REPO_ROOT}"
}

print_complete() {
  printf '\nBenchmark complete:\n'
  if [[ -n "${INSTANCE_ID}" ]]; then
    printf '  Instance: %s (still running)\n' "${INSTANCE_ID}"
  fi
  printf '  Raw results: %s\n' "${RESULT_DIR}"
  printf '  Report: %s\n' "${REPORT_PATH}"
  if [[ "${PROFILE}" == "1" ]]; then
    printf '  Profile JSONL: %s\n' "${PROFILE_RESULT_DIR}"
    printf '  Nsight Compute exports: %s\n' "${PROFILE_EXPORT_DIR}"
    printf '  Profile summaries: %s\n' "${PROFILE_REPORT_DIR}"
  fi
}

main() {
  local profile_status=0

  parse_args "$@"
  load_connection_metadata
  resolve_defaults
  validate_inputs
  collect_source_metadata

  if [[ "${DRY_RUN}" == "1" ]]; then
    print_plan
    return 0
  fi

  require_commands terraform ssh tar git
  if [[ -n "${AWS_PROFILE_NAME}" ]]; then
    export AWS_PROFILE="${AWS_PROFILE_NAME}"
  fi

  load_outputs
  configure_ssh_args
  print_plan
  run_remote_benchmark
  pull_benchmark_artifacts
  if [[ "${PROFILE}" == "1" ]]; then
    run_remote_profile || profile_status=$?
    pull_profile_artifacts || profile_status=$?
  fi
  if [[ "${profile_status}" != "0" ]]; then
    printf 'error: one or more profile targets failed; copied available artifacts\n' >&2
    return "${profile_status}"
  fi
  print_complete
}

main "$@"
