#!/usr/bin/env bash

set -Eeuo pipefail

SCRIPT_DIR=$(cd -- "$(dirname "${BASH_SOURCE[0]}")" && pwd)
REPO_ROOT=$(cd -- "${SCRIPT_DIR}/.." && pwd)

die() {
  printf 'error: %s\n' "$*" >&2
  exit 1
}

print_stage() {
  printf '==> %s\n' "$1"
}

require_commands() {
  local missing=()
  local command_name

  for command_name in "$@"; do
    if ! command -v "${command_name}" >/dev/null 2>&1; then
      missing+=("${command_name}")
    fi
  done

  if ((${#missing[@]} > 0)); then
    die "missing required command(s): ${missing[*]}"
  fi
}

require_value() {
  local option=$1
  local value=${2:-}

  [[ -n "${value}" && "${value}" != --* ]] || die "${option} requires a value"
}

expand_path() {
  local path=$1
  local home_prefix

  printf -v home_prefix '%b' '\x7e/'

  if [[ "${path:0:2}" == "${home_prefix}" ]]; then
    printf '%s/%s\n' "${HOME}" "${path#~/}"
    return
  fi

  printf '%s\n' "${path}"
}

absolute_path() {
  local path
  path=$(expand_path "$1")

  if [[ "${path}" == /* ]]; then
    printf '%s\n' "${path}"
  else
    printf '%s/%s\n' "$(pwd -P)" "${path}"
  fi
}

PLATFORM="${CUDA_KERNEL_LAB_PLATFORM:-runpod}"
AWS_STATE_DIR=$(absolute_path "${CUDA_KERNEL_LAB_AWS_STATE_DIR:-${REPO_ROOT}/.aws-gpu}")
RUNPOD_STATE_DIR=$(absolute_path "${CUDA_KERNEL_LAB_RUNPOD_STATE_DIR:-${REPO_ROOT}/.runpod}")
STATE_DIR=""
CONNECTION_FILE="${CUDA_KERNEL_LAB_CONNECTION_FILE:-}"
TF_DIR=$(absolute_path "${CUDA_KERNEL_LAB_TF_DIR:-${REPO_ROOT}/infra/env/aws-gpu}")
TF_VARS_FILE="${CUDA_KERNEL_LAB_TF_VARS_FILE:-}"

AWS_PROFILE_NAME="${AWS_PROFILE:-}"
AWS_PROFILE_ENV_SET=0
if [[ -n "${AWS_PROFILE:-}" ]]; then
  AWS_PROFILE_ENV_SET=1
fi
RUN_ID=""
SUITE="standard"
KEY_FILE=""
SSH_USER=""
SSH_PORT="22"
REMOTE_DIR="cuda-kernel-lab"
OUTPUT_ROOT=""
REPORT_ROOT=""
INCLUDE_MATMUL=0
INCLUDE_MATMUL_SWEEP=0
INCLUDE_RMSNORM_SHAPE_SWEEP=0
INCLUDE_ATTENTION_BASELINE=0
INCLUDE_DECODE_STEP=0
ONLY_DECODE_STEP=0
INCLUDE_DECODE_BUCKET_SWEEP=0
INCLUDE_DECODE_TAIL_SWEEP=0
DECODE_TAIL_BUCKETS=""
DECODE_TAIL_ITERATIONS=""
DECODE_TAIL_SEEDS=""
DECODE_ATTENTION_BACKEND=""
DECODE_DYNAMIC_COPY_MODE=""
DECODE_PIECEWISE_POST_MODE=""
DECODE_ORCHESTRATION_TIMING=""
PROFILE=0
PROFILE_ONLY=0
PROFILE_MODE="${CUDA_KERNEL_LAB_PROFILE_MODE:-light}"
PROFILE_PRESET="${CUDA_KERNEL_LAB_PROFILE_PRESET:-auto}"
PROFILE_TIMEOUT_SECONDS="${CUDA_KERNEL_LAB_PROFILE_TIMEOUT_SECONDS:-120}"
PROFILE_TARGETS="${CUDA_KERNEL_LAB_PROFILE_TARGETS:-}"
DRY_RUN=0

KEY_FILE_SET=0
SSH_USER_SET=0
SSH_PORT_SET=0
REMOTE_DIR_SET=0
CONNECTION_FILE_SET=0
OUTPUT_ROOT_SET=0
REPORT_ROOT_SET=0
PLATFORM_SET=0
TF_DIR_SET=0
TF_VARS_FILE_SET=0
AWS_PROFILE_SET=0

RESULT_DIR=""
REPORT_PATH=""
PROFILE_RESULT_DIR=""
PROFILE_EXPORT_DIR=""
PROFILE_REPORT_DIR=""
GIT_COMMIT=""
GIT_DIRTY="unknown"
SSH_HOST=""
INSTANCE_ID=""
RUNPOD_POD_ID=""
RUNPOD_GPU_ID=""
RUNPOD_CLOUD_TYPE=""
RUNPOD_IMAGE=""
RUNPOD_TEMPLATE_ID=""
RUNPOD_DATA_CENTER_IDS=""
PROFILE_DEVICE_LABEL="GPU"

ssh_base_args=()

usage() {
  cat <<EOF
Usage:
  ./scripts/benchmark [options]

Runs the benchmark matrix on the GPU host created by ./scripts/up, copies JSONL
results and Markdown reports back locally, and leaves the host running for more
experiments.

Options:
  --platform <name>         Provider platform: runpod or aws. Default: ${PLATFORM}
  --suite <name>            Benchmark suite: standard, h200-roofline,
                            h200-matmul-autotune, or tensor-core.
                            Default: ${SUITE}
  --run-id <id>             Result run id. Default: UTC timestamp.
  --key-file <path>         SSH private key. Default: connection metadata.
  --profile <name>          AWS CLI profile used by Terraform output reads.
  --include-matmul          Include the tiled matmul progression in the matrix.
  --include-matmul-sweep    Include the float16 matmul tile and launch strategy sweep.
  --include-rmsnorm-shape-sweep
                            Include the focused RMSNorm hidden-size and batch-size sweep.
  --include-attention-baseline
                            Include the PyTorch contiguous KV-cache decode-attention baseline.
  --include-decode-step     Include synthetic decode-step graph, piecewise graph, and dynamic trace modes.
  --only-decode-step        Run only synthetic decode-step benchmark modes.
  --include-decode-bucket-sweep
                            Include dynamic decode-step batch-bucket sweep traces.
  --include-decode-tail-sweep
                            Include longer multi-seed dynamic decode-step tail traces.
  --decode-tail-buckets <list>
                            Semicolon-separated tail bucket policies.
                            Default: benchmark-matrix default.
  --decode-tail-iterations <n>
                            Iterations per tail seed. Default: benchmark-matrix default.
  --decode-tail-seeds <csv>
                            Comma-separated tail seeds. Default: benchmark-matrix default.
  --decode-attention-backend <name>
                            Decode-step attention backend: einsum, sdpa, or sdpa-head-major.
                            Default: benchmark-matrix default.
  --decode-dynamic-copy-mode <mode>
                            Dynamic decode-step graph input staging: full, x-only, or resident.
                            Default: benchmark-matrix default.
  --decode-piecewise-post-mode <mode>
                            Dynamic decode-step post-attention add mode: graph or eager.
                            Default: benchmark-matrix default.
  --decode-orchestration-timing <mode>
                            Dynamic decode-step orchestration timing: on or off.
                            Default: benchmark-matrix default.
  --with-profiling          Capture focused Nsight Compute CSV and Markdown summaries.
  --profile-only            Skip the benchmark matrix and run only Nsight Compute profiles.
  --profile-mode <mode>     Nsight Compute capture mode: light or full. Default: ${PROFILE_MODE}
  --profile-preset <name>   Profile target preset: auto, matmul-gaps, broad, or decode.
                            Default: ${PROFILE_PRESET}
  --profile-timeout-seconds <n>
                            Per-target Nsight timeout. Use 0 to disable. Default: ${PROFILE_TIMEOUT_SECONDS}
  --profile-targets <csv>   Comma-separated profile target names. Default: suite-specific set.
  --output-root <path>      Raw JSONL root. Default: provider-specific.
  --report-root <path>      Markdown report root. Default: provider-specific.
  --ssh-user <name>         SSH user. Default: ${SSH_USER}
  --ssh-port <port>         SSH port. Default: connection metadata or 22.
  --remote-dir <path>       Remote repo directory. Default: ${REMOTE_DIR}
  --tf-dir <path>           Terraform environment. Default: ${TF_DIR}
  --tf-vars-file <path>     Terraform variable file label from ./scripts/up.
  --connection-file <path>  Connection metadata file. Default: ${CONNECTION_FILE}
  --dry-run                 Print the planned benchmark without SSH or provider calls.

Examples:
  ./scripts/up
  ./scripts/benchmark --run-id 2026-05-21-a10g-baseline
  ./scripts/benchmark --run-id 2026-05-21-a10g-decode --only-decode-step
  ./scripts/benchmark --run-id 2026-05-21-a10g-profile --with-profiling
  ./scripts/benchmark --run-id 2026-05-21-a10g-matmul --include-matmul-sweep
  ./scripts/benchmark --platform aws --run-id 2026-05-21-a10g-baseline
  ./scripts/down
EOF
}

parse_args() {
  while (($# > 0)); do
    case "$1" in
      -h|--help)
        usage
        exit 0
        ;;
      --run-id)
        require_value "$1" "${2:-}"
        RUN_ID=${2:-}
        shift 2
        ;;
      --platform)
        require_value "$1" "${2:-}"
        PLATFORM=${2:-}
        PLATFORM_SET=1
        shift 2
        ;;
      --platform=*)
        PLATFORM=${1#*=}
        PLATFORM_SET=1
        shift
        ;;
      --suite)
        require_value "$1" "${2:-}"
        SUITE=${2:-}
        shift 2
        ;;
      --suite=*)
        SUITE=${1#*=}
        shift
        ;;
      --key-file)
        require_value "$1" "${2:-}"
        KEY_FILE=$(absolute_path "${2:-}")
        KEY_FILE_SET=1
        shift 2
        ;;
      --profile)
        require_value "$1" "${2:-}"
        AWS_PROFILE_NAME=${2:-}
        AWS_PROFILE_SET=1
        shift 2
        ;;
      --include-matmul)
        INCLUDE_MATMUL=1
        shift
        ;;
      --include-matmul-sweep)
        INCLUDE_MATMUL_SWEEP=1
        shift
        ;;
      --include-rmsnorm-shape-sweep)
        INCLUDE_RMSNORM_SHAPE_SWEEP=1
        shift
        ;;
      --include-attention-baseline)
        INCLUDE_ATTENTION_BASELINE=1
        shift
        ;;
      --include-decode-step)
        INCLUDE_DECODE_STEP=1
        shift
        ;;
      --only-decode-step)
        ONLY_DECODE_STEP=1
        shift
        ;;
      --include-decode-bucket-sweep)
        INCLUDE_DECODE_BUCKET_SWEEP=1
        shift
        ;;
      --include-decode-tail-sweep)
        INCLUDE_DECODE_TAIL_SWEEP=1
        shift
        ;;
      --decode-tail-buckets)
        require_value "$1" "${2:-}"
        DECODE_TAIL_BUCKETS=${2:-}
        shift 2
        ;;
      --decode-tail-iterations)
        require_value "$1" "${2:-}"
        DECODE_TAIL_ITERATIONS=${2:-}
        shift 2
        ;;
      --decode-tail-seeds)
        require_value "$1" "${2:-}"
        DECODE_TAIL_SEEDS=${2:-}
        shift 2
        ;;
      --decode-attention-backend)
        require_value "$1" "${2:-}"
        DECODE_ATTENTION_BACKEND=${2:-}
        shift 2
        ;;
      --decode-dynamic-copy-mode)
        require_value "$1" "${2:-}"
        DECODE_DYNAMIC_COPY_MODE=${2:-}
        shift 2
        ;;
      --decode-piecewise-post-mode)
        require_value "$1" "${2:-}"
        DECODE_PIECEWISE_POST_MODE=${2:-}
        shift 2
        ;;
      --decode-orchestration-timing)
        require_value "$1" "${2:-}"
        DECODE_ORCHESTRATION_TIMING=${2:-}
        shift 2
        ;;
      --with-profiling)
        PROFILE=1
        shift
        ;;
      --profile-only)
        PROFILE=1
        PROFILE_ONLY=1
        shift
        ;;
      --profile-mode)
        require_value "$1" "${2:-}"
        PROFILE_MODE=${2:-}
        shift 2
        ;;
      --profile-preset)
        require_value "$1" "${2:-}"
        PROFILE_PRESET=${2:-}
        shift 2
        ;;
      --profile-timeout-seconds)
        require_value "$1" "${2:-}"
        PROFILE_TIMEOUT_SECONDS=${2:-}
        shift 2
        ;;
      --profile-targets)
        require_value "$1" "${2:-}"
        PROFILE_TARGETS=${2:-}
        shift 2
        ;;
      --output-root)
        require_value "$1" "${2:-}"
        OUTPUT_ROOT=${2:-}
        OUTPUT_ROOT_SET=1
        shift 2
        ;;
      --report-root)
        require_value "$1" "${2:-}"
        REPORT_ROOT=${2:-}
        REPORT_ROOT_SET=1
        shift 2
        ;;
      --ssh-user)
        require_value "$1" "${2:-}"
        SSH_USER=${2:-}
        SSH_USER_SET=1
        shift 2
        ;;
      --ssh-port)
        require_value "$1" "${2:-}"
        SSH_PORT=${2:-}
        SSH_PORT_SET=1
        shift 2
        ;;
      --remote-dir)
        require_value "$1" "${2:-}"
        REMOTE_DIR=${2:-}
        REMOTE_DIR_SET=1
        shift 2
        ;;
      --tf-dir)
        require_value "$1" "${2:-}"
        TF_DIR=$(absolute_path "${2:-}")
        TF_DIR_SET=1
        shift 2
        ;;
      --tf-vars-file)
        require_value "$1" "${2:-}"
        TF_VARS_FILE=$(absolute_path "${2:-}")
        TF_VARS_FILE_SET=1
        shift 2
        ;;
      --connection-file)
        require_value "$1" "${2:-}"
        CONNECTION_FILE=$(absolute_path "${2:-}")
        CONNECTION_FILE_SET=1
        shift 2
        ;;
      --dry-run)
        DRY_RUN=1
        shift
        ;;
      *)
        die "unknown argument: $1"
        ;;
    esac
  done
}

validate_platform() {
  case "${PLATFORM}" in
    runpod|aws)
      ;;
    *)
      die "--platform must be one of: runpod, aws"
      ;;
  esac
}

validate_suite() {
  case "${SUITE}" in
    standard|h200-roofline|h200-matmul-autotune|tensor-core)
      ;;
    *)
      die "--suite must be one of: standard, h200-roofline, h200-matmul-autotune, tensor-core"
      ;;
  esac
}

resolve_connection_default() {
  validate_platform

  if [[ "${CONNECTION_FILE_SET}" == "0" && -z "${CONNECTION_FILE}" ]]; then
    if [[ "${PLATFORM}" == "runpod" ]]; then
      STATE_DIR="${RUNPOD_STATE_DIR}"
    else
      STATE_DIR="${AWS_STATE_DIR}"
    fi
    CONNECTION_FILE="${STATE_DIR}/connection.env"
    return
  fi

  CONNECTION_FILE=$(absolute_path "${CONNECTION_FILE}")
  STATE_DIR=$(absolute_path "$(dirname "${CONNECTION_FILE}")")
}

resolve_provider_defaults() {
  validate_platform

  if [[ -z "${SSH_USER}" ]]; then
    if [[ "${PLATFORM}" == "runpod" ]]; then
      SSH_USER="root"
    else
      SSH_USER="ubuntu"
    fi
  fi

  if [[ "${OUTPUT_ROOT_SET}" == "0" && -z "${OUTPUT_ROOT}" ]]; then
    if [[ "${PLATFORM}" == "runpod" ]]; then
      OUTPUT_ROOT="experiments/results/runpod"
    else
      OUTPUT_ROOT="experiments/results/aws-ec2"
    fi
  fi

  if [[ "${REPORT_ROOT_SET}" == "0" && -z "${REPORT_ROOT}" ]]; then
    if [[ "${PLATFORM}" == "runpod" ]]; then
      REPORT_ROOT="experiments/reports/runpod"
    else
      REPORT_ROOT="experiments/reports/aws-ec2"
    fi
  fi

  if [[ "${PLATFORM}" == "runpod" ]]; then
    PROFILE_DEVICE_LABEL="${RUNPOD_GPU_ID:-GPU}"
  elif [[ -n "${INSTANCE_ID}" ]]; then
    PROFILE_DEVICE_LABEL="${INSTANCE_ID}"
  else
    PROFILE_DEVICE_LABEL="GPU"
  fi
}

load_connection_metadata() {
  local cli_platform=${PLATFORM}
  local cli_aws_profile_name=${AWS_PROFILE_NAME}
  local cli_key_file=${KEY_FILE}
  local cli_remote_dir=${REMOTE_DIR}
  local cli_ssh_user=${SSH_USER}
  local cli_ssh_port=${SSH_PORT}
  local cli_tf_dir=${TF_DIR}
  local cli_tf_vars_file=${TF_VARS_FILE}

  if [[ -f "${CONNECTION_FILE}" ]]; then
    # shellcheck disable=SC1090
    source "${CONNECTION_FILE}"
  fi

  if [[ "${PLATFORM_SET}" == "1" ]]; then
    PLATFORM=${cli_platform}
  elif [[ -n "${PROVIDER_PLATFORM:-}" ]]; then
    PLATFORM=${PROVIDER_PLATFORM}
  fi
  if [[ "${KEY_FILE_SET}" == "1" ]]; then
    KEY_FILE=${cli_key_file}
  fi
  if [[ "${SSH_USER_SET}" == "1" ]]; then
    SSH_USER=${cli_ssh_user}
  fi
  if [[ "${SSH_PORT_SET}" == "1" ]]; then
    SSH_PORT=${cli_ssh_port}
  fi
  if [[ "${REMOTE_DIR_SET}" == "1" ]]; then
    REMOTE_DIR=${cli_remote_dir}
  fi
  if [[ "${TF_DIR_SET}" == "1" ]]; then
    TF_DIR=${cli_tf_dir}
  fi
  if [[ "${TF_VARS_FILE_SET}" == "1" ]]; then
    TF_VARS_FILE=${cli_tf_vars_file}
  fi
  if [[ "${AWS_PROFILE_SET}" == "1" || "${AWS_PROFILE_ENV_SET}" == "1" ]]; then
    AWS_PROFILE_NAME=${cli_aws_profile_name}
  fi
}

validate_slug() {
  local label=$1
  local value=$2

  [[ "${value}" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || {
    die "${label} must use only letters, numbers, dots, underscores, and dashes"
  }
}

validate_relative_path() {
  local label=$1
  local value=$2

  [[ "${value}" =~ ^[A-Za-z0-9._/-]+$ ]] || die "${label} contains unsafe characters"
  [[ "${value}" != /* && "${value}" != *..* ]] || {
    die "${label} must be a relative path without '..'"
  }
  [[ "${value}" != "." && "${value}" != .* && "${value}" != */.* ]] || {
    die "${label} must not target hidden or current-directory paths"
  }
}

validate_positive_integer() {
  local label=$1
  local value=$2

  [[ "${value}" =~ ^[1-9][0-9]*$ ]] || die "${label} must be a positive integer"
}

validate_non_negative_integer() {
  local label=$1
  local value=$2

  [[ "${value}" =~ ^[0-9]+$ ]] || die "${label} must be a non-negative integer"
}

validate_integer_csv() {
  local label=$1
  local value=$2

  [[ "${value}" =~ ^[0-9]+(,[0-9]+)*$ ]] || {
    die "${label} must be a comma-separated list of non-negative integers"
  }
}

validate_bucket_policy_list() {
  local label=$1
  local value=$2

  [[ "${value}" =~ ^[0-9]+(,[0-9]+)*(;[0-9]+(,[0-9]+)*)*$ ]] || {
    die "${label} must be semicolon-separated bucket lists like 1,2,4,8;1,2,3,4,6,8"
  }
}

validate_decode_attention_backend() {
  case "$1" in
    ""|einsum|sdpa|sdpa-head-major)
      ;;
    *)
      die "--decode-attention-backend must be one of: einsum, sdpa, sdpa-head-major"
      ;;
  esac
}

validate_decode_dynamic_copy_mode() {
  case "$1" in
    ""|full|x-only|resident)
      ;;
    *)
      die "--decode-dynamic-copy-mode must be one of: full, x-only, resident"
      ;;
  esac
}

validate_decode_piecewise_post_mode() {
  case "$1" in
    ""|graph|eager)
      ;;
    *)
      die "--decode-piecewise-post-mode must be one of: graph, eager"
      ;;
  esac
}

validate_decode_orchestration_timing() {
  case "$1" in
    ""|on|off)
      ;;
    *)
      die "--decode-orchestration-timing must be one of: on, off"
      ;;
  esac
}

validate_decode_tail_options() {
  if [[ "${INCLUDE_DECODE_TAIL_SWEEP}" == "1" ]]; then
    if [[ -n "${DECODE_TAIL_BUCKETS}" ]]; then
      validate_bucket_policy_list "--decode-tail-buckets" "${DECODE_TAIL_BUCKETS}"
    fi
    if [[ -n "${DECODE_TAIL_ITERATIONS}" ]]; then
      validate_positive_integer "--decode-tail-iterations" "${DECODE_TAIL_ITERATIONS}"
    fi
    if [[ -n "${DECODE_TAIL_SEEDS}" ]]; then
      validate_integer_csv "--decode-tail-seeds" "${DECODE_TAIL_SEEDS}"
    fi
  elif [[ -n "${DECODE_TAIL_BUCKETS}" || -n "${DECODE_TAIL_ITERATIONS}" || -n "${DECODE_TAIL_SEEDS}" ]]; then
    die "decode tail options require --include-decode-tail-sweep"
  fi
}

is_profile_target() {
  case "$1" in
    memory-vector-add-float32|memory-reduction-iterative-float32|memory-reduction-two-pass-float32|norms-rmsnorm-float16|matmul-tiled-float16|matmul-tensor-core-float16|matmul-tensor-core-bfloat16|matmul-llm-up-bfloat16|matmul-llm-down-bfloat16|decode-step-naive-eager-float16|decode-step-fused-eager-float16|decode-step-naive-graph-float16|decode-step-fused-graph-float16|decode-step-fused-piecewise-graph-float16|decode-step-fused-piecewise-graph-same-stream-float16|decode-step-dynamic-eager-float16|decode-step-dynamic-piecewise-graph-float16|decode-step-dynamic-piecewise-graph-same-stream-float16)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

validate_profile_options() {
  local target
  local targets=()

  case "${PROFILE_MODE}" in
    light|full)
      ;;
    *)
      die "--profile-mode must be one of: light, full"
      ;;
  esac

  case "${PROFILE_PRESET}" in
    auto|matmul-gaps|broad|decode)
      ;;
    *)
      die "--profile-preset must be one of: auto, matmul-gaps, broad, decode"
      ;;
  esac

  validate_non_negative_integer "--profile-timeout-seconds" "${PROFILE_TIMEOUT_SECONDS}"

  if [[ -n "${PROFILE_TARGETS}" ]]; then
    [[ "${PROFILE_TARGETS}" =~ ^[A-Za-z0-9._-]+(,[A-Za-z0-9._-]+)*$ ]] || {
      die "--profile-targets must be a comma-separated list of target names"
    }
    IFS=',' read -r -a targets <<< "${PROFILE_TARGETS}"
    for target in "${targets[@]}"; do
      is_profile_target "${target}" || die "unknown profile target: ${target}"
    done
  fi
}

resolve_defaults() {
  if [[ -z "${RUN_ID}" ]]; then
    RUN_ID=$(date -u +%Y%m%dT%H%M%SZ)
  fi
  validate_slug "--run-id" "${RUN_ID}"

  RESULT_DIR="${OUTPUT_ROOT}/${RUN_ID}"
  REPORT_PATH="${REPORT_ROOT}/${RUN_ID}.md"
  PROFILE_RESULT_DIR="${OUTPUT_ROOT}/${RUN_ID}-profiled"
  PROFILE_EXPORT_DIR="profiling/nsight_compute/${RUN_ID}"
  PROFILE_REPORT_DIR="profiling/reports/${RUN_ID}"
}

validate_inputs() {
  validate_suite
  if [[ "${PLATFORM}" == "aws" ]]; then
    [[ -d "${TF_DIR}" ]] || die "Terraform directory does not exist: ${TF_DIR}"
  fi
  [[ "${SSH_USER}" =~ ^[A-Za-z_][A-Za-z0-9_.-]*[$]?$ ]] || die "--ssh-user contains unsafe characters"
  [[ "${SSH_PORT}" =~ ^[0-9]+$ ]] || die "--ssh-port must be an integer"
  validate_relative_path "--remote-dir" "${REMOTE_DIR}"
  validate_relative_path "--output-root" "${OUTPUT_ROOT}"
  validate_relative_path "--report-root" "${REPORT_ROOT}"
  validate_relative_path "profile export directory" "${PROFILE_EXPORT_DIR}"
  validate_relative_path "profile report directory" "${PROFILE_REPORT_DIR}"
  validate_decode_tail_options
  validate_decode_attention_backend "${DECODE_ATTENTION_BACKEND}"
  validate_decode_dynamic_copy_mode "${DECODE_DYNAMIC_COPY_MODE}"
  validate_decode_piecewise_post_mode "${DECODE_PIECEWISE_POST_MODE}"
  validate_decode_orchestration_timing "${DECODE_ORCHESTRATION_TIMING}"
  if [[ "${PROFILE}" == "1" ]]; then
    validate_profile_options
  fi

  if [[ -z "${KEY_FILE}" ]]; then
    die "missing SSH key file; run ./scripts/up first or pass --key-file"
  fi
  if [[ "${DRY_RUN}" == "0" && ! -f "${KEY_FILE}" ]]; then
    die "SSH key file does not exist: ${KEY_FILE}"
  fi

  if [[ "${DRY_RUN}" == "0" ]]; then
    if [[ "${PROFILE_ONLY}" != "1" ]]; then
      [[ ! -e "${REPO_ROOT}/${RESULT_DIR}" ]] || die "result directory already exists: ${RESULT_DIR}"
      [[ ! -e "${REPO_ROOT}/${REPORT_PATH}" ]] || die "report already exists: ${REPORT_PATH}"
    fi
    if [[ "${PROFILE}" == "1" ]]; then
      [[ ! -e "${REPO_ROOT}/${PROFILE_RESULT_DIR}" ]] || {
        die "profile result directory already exists: ${PROFILE_RESULT_DIR}"
      }
      [[ ! -e "${REPO_ROOT}/${PROFILE_EXPORT_DIR}" ]] || {
        die "profile export directory already exists: ${PROFILE_EXPORT_DIR}"
      }
      [[ ! -e "${REPO_ROOT}/${PROFILE_REPORT_DIR}" ]] || {
        die "profile report directory already exists: ${PROFILE_REPORT_DIR}"
      }
    fi
  fi
}

collect_source_metadata() {
  GIT_COMMIT=$(git -C "${REPO_ROOT}" rev-parse HEAD 2>/dev/null || true)

  local status
  if status=$(git -C "${REPO_ROOT}" status --short 2>/dev/null); then
    if [[ -n "${status}" ]]; then
      GIT_DIRTY="true"
    else
      GIT_DIRTY="false"
    fi
  fi
}

load_outputs() {
  if [[ "${PLATFORM}" == "runpod" ]]; then
    [[ -n "${SSH_HOST}" ]] || die "missing SSH_HOST in Runpod connection metadata; run ./scripts/up first"
    INSTANCE_ID="${RUNPOD_POD_ID:-}"
    return
  fi

  if ! SSH_HOST=$(terraform -chdir="${TF_DIR}" output -raw ssh_host 2>/dev/null); then
    die "could not read Terraform ssh_host output; run ./scripts/up first"
  fi
  INSTANCE_ID=$(terraform -chdir="${TF_DIR}" output -raw instance_id 2>/dev/null || true)
}

print_command() {
  printf '  '
  printf '%q ' "$@"
  printf '\n'
}

shell_quote() {
  printf '%q' "$1"
}

remote_ncu_finder_command() {
  printf '%s' "find_ncu_bin() { if command -v ncu >/dev/null 2>&1; then command -v ncu; return 0; fi; for candidate in /usr/local/cuda/bin/ncu /opt/nvidia/nsight-compute/*/ncu /usr/local/NVIDIA-Nsight-Compute*/ncu; do if [ -x \"\${candidate}\" ]; then printf '%s\n' \"\${candidate}\"; return 0; fi; done; return 1; }"
}

profile_ncu_args() {
  local metrics

  if [[ "${PROFILE_MODE}" == "full" ]]; then
    printf '%s\n' "--set full"
    return
  fi

  metrics="gpu__time_duration.sum"
  metrics+=",dram__throughput.avg.pct_of_peak_sustained_elapsed"
  metrics+=",gpu__dram_throughput.avg.pct_of_peak_sustained_elapsed"
  metrics+=",dram__bytes_read.sum"
  metrics+=",dram__bytes_write.sum"
  metrics+=",sm__warps_active.avg.pct_of_peak_sustained_active"
  metrics+=",launch__registers_per_thread"
  metrics+=",launch__shared_mem_per_block_static"
  metrics+=",launch__shared_mem_per_block_dynamic"
  metrics+=",sm__pipe_tensor_cycles_active.avg.pct_of_peak_sustained_active"
  metrics+=",sm__pipe_tensor_op_hmma_cycles_active.avg.pct_of_peak_sustained_active"
  metrics+=",smsp__inst_executed_pipe_tensor.sum"
  metrics+=",smsp__sass_thread_inst_executed_op_hmma_pred_on.sum"
  printf '%s\n' "--metrics ${metrics}"
}

remote_benchmark_command() {
  local command

  command="cd ~/${REMOTE_DIR}"
  command+=" && export PATH=\"\$HOME/.local/bin:\$PATH:/usr/local/cuda/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin\""
  if [[ -n "${GIT_COMMIT}" ]]; then
    command+=" && export CUDA_KERNEL_LAB_GIT_COMMIT=${GIT_COMMIT}"
  fi
  command+=" && export CUDA_KERNEL_LAB_GIT_DIRTY=${GIT_DIRTY}"
  command+=" && export CUDA_KERNEL_LAB_PROVIDER=${PLATFORM}"
  if [[ "${PLATFORM}" == "runpod" ]]; then
    if [[ -n "${RUNPOD_POD_ID}" ]]; then
      command+=" && export CUDA_KERNEL_LAB_PROVIDER_ID=$(shell_quote "${RUNPOD_POD_ID}")"
    fi
    if [[ -n "${RUNPOD_GPU_ID}" ]]; then
      command+=" && export CUDA_KERNEL_LAB_PROVIDER_GPU_ID=$(shell_quote "${RUNPOD_GPU_ID}")"
    fi
    if [[ -n "${RUNPOD_CLOUD_TYPE}" ]]; then
      command+=" && export CUDA_KERNEL_LAB_PROVIDER_CLOUD_TYPE=$(shell_quote "${RUNPOD_CLOUD_TYPE}")"
    fi
    if [[ -n "${RUNPOD_IMAGE}" ]]; then
      command+=" && export CUDA_KERNEL_LAB_PROVIDER_IMAGE=$(shell_quote "${RUNPOD_IMAGE}")"
    fi
    if [[ -n "${RUNPOD_TEMPLATE_ID}" ]]; then
      command+=" && export CUDA_KERNEL_LAB_PROVIDER_TEMPLATE_ID=$(shell_quote "${RUNPOD_TEMPLATE_ID}")"
    fi
    if [[ -n "${RUNPOD_DATA_CENTER_IDS}" ]]; then
      command+=" && export CUDA_KERNEL_LAB_PROVIDER_REGION=$(shell_quote "${RUNPOD_DATA_CENTER_IDS}")"
    fi
  elif [[ -n "${INSTANCE_ID}" ]]; then
    command+=" && export CUDA_KERNEL_LAB_PROVIDER_ID=$(shell_quote "${INSTANCE_ID}")"
  fi
  command+=" && uv run benchmark-matrix --output-dir ${RESULT_DIR}"
  if [[ "${SUITE}" != "standard" ]]; then
    command+=" --suite ${SUITE}"
  fi
  if [[ "${ONLY_DECODE_STEP}" == "1" ]]; then
    command+=" --only-decode-step"
  else
    command+=" --include-vector-add-sweep --include-reduction-sweep"
    if [[ "${INCLUDE_MATMUL}" == "1" ]]; then
      command+=" --include-matmul"
    fi
    if [[ "${INCLUDE_MATMUL_SWEEP}" == "1" ]]; then
      command+=" --include-matmul-sweep --matmul-input-precision tf32"
    fi
    if [[ "${INCLUDE_RMSNORM_SHAPE_SWEEP}" == "1" ]]; then
      command+=" --include-rmsnorm-shape-sweep"
    fi
    if [[ "${INCLUDE_ATTENTION_BASELINE}" == "1" ]]; then
      command+=" --include-attention-baseline"
    fi
  fi
  if [[ "${INCLUDE_DECODE_STEP}" == "1" ]]; then
    command+=" --include-decode-step"
  fi
  if [[ "${INCLUDE_DECODE_BUCKET_SWEEP}" == "1" ]]; then
    command+=" --include-decode-bucket-sweep"
  fi
  if [[ "${INCLUDE_DECODE_TAIL_SWEEP}" == "1" ]]; then
    command+=" --include-decode-tail-sweep"
    if [[ -n "${DECODE_TAIL_BUCKETS}" ]]; then
      command+=" --decode-tail-buckets $(shell_quote "${DECODE_TAIL_BUCKETS}")"
    fi
    if [[ -n "${DECODE_TAIL_ITERATIONS}" ]]; then
      command+=" --decode-tail-iterations ${DECODE_TAIL_ITERATIONS}"
    fi
    if [[ -n "${DECODE_TAIL_SEEDS}" ]]; then
      command+=" --decode-tail-seeds $(shell_quote "${DECODE_TAIL_SEEDS}")"
    fi
  fi
  if [[ -n "${DECODE_ATTENTION_BACKEND}" ]]; then
    command+=" --decode-attention-backend ${DECODE_ATTENTION_BACKEND}"
  fi
  if [[ -n "${DECODE_DYNAMIC_COPY_MODE}" ]]; then
    command+=" --decode-dynamic-copy-mode ${DECODE_DYNAMIC_COPY_MODE}"
  fi
  if [[ -n "${DECODE_PIECEWISE_POST_MODE}" ]]; then
    command+=" --decode-piecewise-post-mode ${DECODE_PIECEWISE_POST_MODE}"
  fi
  if [[ -n "${DECODE_ORCHESTRATION_TIMING}" ]]; then
    command+=" --decode-orchestration-timing ${DECODE_ORCHESTRATION_TIMING}"
  fi
  if [[ "${SUITE}" == "h200-matmul-autotune" ]]; then
    command+=" && uv run benchmark-autotune --input-dir ${RESULT_DIR} --output ${RESULT_DIR}/h200-matmul-best.json --markdown-output ${RESULT_DIR}/h200-matmul-best.md"
  fi
  command+=" && uv run benchmark-report --input-dir ${RESULT_DIR} --output ${REPORT_PATH}"

  printf '%s\n' "${command}"
}

remote_profile_preflight_command() {
  local command

  command="cd ~/${REMOTE_DIR}"
  command+=" && export PATH=\"\$HOME/.local/bin:\$PATH:/usr/local/cuda/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin\""
  command+="; $(remote_ncu_finder_command)"
  command+="; ncu_bin=\$(find_ncu_bin || true)"
  command+="; if [ -z \"\${ncu_bin}\" ]; then printf 'error: ncu was not found on the remote host. Recreate the Pod with ./scripts/up or install Nsight Compute before --with-profiling.\\n' >&2; exit 1; fi"
  command+="; \"\${ncu_bin}\" --version | head -n 1 >/dev/null"

  printf '%s\n' "${command}"
}

profile_benchmark_command() {
  local target=$1

  case "${target}" in
    memory-vector-add-float32)
      printf '%s\n' \
        "uv run benchmark-memory --backend triton --device cuda --op vector_add --numel 16777216 --dtype float32 --block-size 1024 --warmup 5 --iterations 10 --skip-correctness --output ${PROFILE_RESULT_DIR}/memory-vector-add-float32.jsonl"
      ;;
    memory-reduction-iterative-float32)
      printf '%s\n' \
        "uv run benchmark-memory --backend triton --device cuda --op reduction_sum --numel 16777216 --dtype float32 --block-size 1024 --reduction-strategy iterative --warmup 5 --iterations 10 --skip-correctness --output ${PROFILE_RESULT_DIR}/memory-reduction-iterative-float32.jsonl"
      ;;
    memory-reduction-two-pass-float32)
      printf '%s\n' \
        "uv run benchmark-memory --backend triton --device cuda --op reduction_sum --numel 16777216 --dtype float32 --block-size 1024 --reduction-strategy two_pass --warmup 5 --iterations 10 --skip-correctness --output ${PROFILE_RESULT_DIR}/memory-reduction-two-pass-float32.jsonl"
      ;;
    norms-rmsnorm-float16)
      printf '%s\n' \
        "uv run benchmark-norms --backend triton --device cuda --op rmsnorm --rows 4096 --cols 4096 --dtype float16 --warmup 5 --iterations 10 --skip-correctness --output ${PROFILE_RESULT_DIR}/norms-rmsnorm-float16.jsonl"
      ;;
    matmul-tiled-float16)
      printf '%s\n' \
        "uv run benchmark-matmul --backend triton --device cuda --m 1024 --n 1024 --k 1024 --dtype float16 --block-m 64 --block-n 64 --block-k 32 --num-warps 4 --num-stages 3 --input-precision tf32 --warmup 5 --iterations 10 --skip-correctness --output ${PROFILE_RESULT_DIR}/matmul-tiled-float16.jsonl"
      ;;
    matmul-tensor-core-float16)
      printf '%s\n' \
        "uv run benchmark-matmul --backend triton --device cuda --m 4096 --n 4096 --k 4096 --dtype float16 --block-m 128 --block-n 128 --block-k 64 --num-warps 4 --num-stages 4 --input-precision tf32 --warmup 5 --iterations 10 --skip-correctness --output ${PROFILE_RESULT_DIR}/matmul-tensor-core-float16.jsonl"
      ;;
    matmul-tensor-core-bfloat16)
      printf '%s\n' \
        "uv run benchmark-matmul --backend triton --device cuda --m 4096 --n 4096 --k 4096 --dtype bfloat16 --block-m 128 --block-n 128 --block-k 64 --num-warps 4 --num-stages 4 --input-precision tf32 --warmup 5 --iterations 10 --skip-correctness --output ${PROFILE_RESULT_DIR}/matmul-tensor-core-bfloat16.jsonl"
      ;;
    matmul-llm-up-bfloat16)
      printf '%s\n' \
        "uv run benchmark-matmul --backend triton --device cuda --m 512 --n 4096 --k 11008 --dtype bfloat16 --block-m 128 --block-n 128 --block-k 64 --num-warps 4 --num-stages 4 --input-precision tf32 --warmup 5 --iterations 10 --skip-correctness --output ${PROFILE_RESULT_DIR}/matmul-llm-up-bfloat16.jsonl"
      ;;
    matmul-llm-down-bfloat16)
      printf '%s\n' \
        "uv run benchmark-matmul --backend triton --device cuda --m 512 --n 11008 --k 4096 --dtype bfloat16 --block-m 128 --block-n 128 --block-k 64 --num-warps 4 --num-stages 4 --input-precision tf32 --warmup 5 --iterations 10 --skip-correctness --output ${PROFILE_RESULT_DIR}/matmul-llm-down-bfloat16.jsonl"
      ;;
    decode-step-naive-eager-float16)
      printf '%s\n' \
        "uv run benchmark-decode-step --mode naive-eager --device cuda --dtype float16 --warmup 5 --iterations 10 --skip-correctness --output ${PROFILE_RESULT_DIR}/decode-step-naive-eager-float16.jsonl"
      ;;
    decode-step-fused-eager-float16)
      printf '%s\n' \
        "uv run benchmark-decode-step --mode fused-eager --device cuda --dtype float16 --warmup 5 --iterations 10 --skip-correctness --output ${PROFILE_RESULT_DIR}/decode-step-fused-eager-float16.jsonl"
      ;;
    decode-step-naive-graph-float16)
      printf '%s\n' \
        "uv run benchmark-decode-step --mode naive-graph --device cuda --dtype float16 --warmup 5 --iterations 10 --skip-correctness --output ${PROFILE_RESULT_DIR}/decode-step-naive-graph-float16.jsonl"
      ;;
    decode-step-fused-graph-float16)
      printf '%s\n' \
        "uv run benchmark-decode-step --mode fused-graph --device cuda --dtype float16 --warmup 5 --iterations 10 --skip-correctness --output ${PROFILE_RESULT_DIR}/decode-step-fused-graph-float16.jsonl"
      ;;
    decode-step-fused-piecewise-graph-float16)
      printf '%s\n' \
        "uv run benchmark-decode-step --mode fused-piecewise-graph --device cuda --dtype float16 --warmup 5 --iterations 10 --skip-correctness --output ${PROFILE_RESULT_DIR}/decode-step-fused-piecewise-graph-float16.jsonl"
      ;;
    decode-step-fused-piecewise-graph-same-stream-float16)
      printf '%s\n' \
        "uv run benchmark-decode-step --mode fused-piecewise-graph-same-stream --device cuda --dtype float16 --warmup 5 --iterations 10 --skip-correctness --output ${PROFILE_RESULT_DIR}/decode-step-fused-piecewise-graph-same-stream-float16.jsonl"
      ;;
    decode-step-dynamic-eager-float16)
      printf '%s\n' \
        "uv run benchmark-decode-step --dynamic-trace --mode dynamic-eager --device cuda --dtype float16 --warmup 5 --iterations 10 --skip-correctness --output ${PROFILE_RESULT_DIR}/decode-step-dynamic-eager-float16.jsonl"
      ;;
    decode-step-dynamic-piecewise-graph-float16)
      printf '%s\n' \
        "uv run benchmark-decode-step --dynamic-trace --mode dynamic-piecewise-graph --device cuda --dtype float16 --warmup 5 --iterations 10 --skip-correctness --output ${PROFILE_RESULT_DIR}/decode-step-dynamic-piecewise-graph-float16.jsonl"
      ;;
    decode-step-dynamic-piecewise-graph-same-stream-float16)
      printf '%s\n' \
        "uv run benchmark-decode-step --dynamic-trace --mode dynamic-piecewise-graph-same-stream --device cuda --dtype float16 --warmup 5 --iterations 10 --skip-correctness --output ${PROFILE_RESULT_DIR}/decode-step-dynamic-piecewise-graph-same-stream-float16.jsonl"
      ;;
    *)
      die "unknown profile target: ${target}"
      ;;
  esac
}

profile_title() {
  local target=$1

  case "${target}" in
    memory-vector-add-float32)
      printf '%s\n' "${PROFILE_DEVICE_LABEL} vector_add float32 profile"
      ;;
    memory-reduction-iterative-float32)
      printf '%s\n' "${PROFILE_DEVICE_LABEL} reduction_sum iterative float32 profile"
      ;;
    memory-reduction-two-pass-float32)
      printf '%s\n' "${PROFILE_DEVICE_LABEL} reduction_sum two-pass float32 profile"
      ;;
    norms-rmsnorm-float16)
      printf '%s\n' "${PROFILE_DEVICE_LABEL} RMSNorm float16 profile"
      ;;
    matmul-tiled-float16)
      printf '%s\n' "${PROFILE_DEVICE_LABEL} matmul float16 tiled-dot profile"
      ;;
    matmul-tensor-core-float16)
      printf '%s\n' "${PROFILE_DEVICE_LABEL} matmul float16 Tensor Core roofline profile"
      ;;
    matmul-tensor-core-bfloat16)
      printf '%s\n' "${PROFILE_DEVICE_LABEL} matmul bfloat16 Tensor Core roofline profile"
      ;;
    matmul-llm-up-bfloat16)
      printf '%s\n' "${PROFILE_DEVICE_LABEL} matmul bfloat16 512x4096x11008 profile"
      ;;
    matmul-llm-down-bfloat16)
      printf '%s\n' "${PROFILE_DEVICE_LABEL} matmul bfloat16 512x11008x4096 profile"
      ;;
    decode-step-naive-eager-float16)
      printf '%s\n' "${PROFILE_DEVICE_LABEL} decode step naive eager float16 profile"
      ;;
    decode-step-fused-eager-float16)
      printf '%s\n' "${PROFILE_DEVICE_LABEL} decode step fused eager float16 profile"
      ;;
    decode-step-naive-graph-float16)
      printf '%s\n' "${PROFILE_DEVICE_LABEL} decode step naive CUDA Graph float16 profile"
      ;;
    decode-step-fused-graph-float16)
      printf '%s\n' "${PROFILE_DEVICE_LABEL} decode step fused CUDA Graph float16 profile"
      ;;
    decode-step-fused-piecewise-graph-float16)
      printf '%s\n' "${PROFILE_DEVICE_LABEL} decode step fused piecewise CUDA Graph float16 profile"
      ;;
    decode-step-fused-piecewise-graph-same-stream-float16)
      printf '%s\n' "${PROFILE_DEVICE_LABEL} decode step fused same-stream piecewise CUDA Graph float16 profile"
      ;;
    decode-step-dynamic-eager-float16)
      printf '%s\n' "${PROFILE_DEVICE_LABEL} dynamic decode step eager float16 profile"
      ;;
    decode-step-dynamic-piecewise-graph-float16)
      printf '%s\n' "${PROFILE_DEVICE_LABEL} dynamic decode step piecewise CUDA Graph float16 profile"
      ;;
    decode-step-dynamic-piecewise-graph-same-stream-float16)
      printf '%s\n' "${PROFILE_DEVICE_LABEL} dynamic decode step same-stream piecewise CUDA Graph float16 profile"
      ;;
    *)
      die "unknown profile target: ${target}"
      ;;
  esac
}

profile_operation() {
  local target=$1

  case "${target}" in
    memory-vector-add-float32)
      printf '%s\n' "vector_add"
      ;;
    memory-reduction-iterative-float32|memory-reduction-two-pass-float32)
      printf '%s\n' "reduction_sum"
      ;;
    norms-rmsnorm-float16)
      printf '%s\n' "rmsnorm"
      ;;
    matmul-tiled-float16|matmul-tensor-core-float16|matmul-tensor-core-bfloat16|matmul-llm-up-bfloat16|matmul-llm-down-bfloat16)
      printf '%s\n' "matmul"
      ;;
    decode-step-naive-eager-float16|decode-step-fused-eager-float16|decode-step-naive-graph-float16|decode-step-fused-graph-float16|decode-step-fused-piecewise-graph-float16|decode-step-fused-piecewise-graph-same-stream-float16|decode-step-dynamic-eager-float16|decode-step-dynamic-piecewise-graph-float16|decode-step-dynamic-piecewise-graph-same-stream-float16)
      printf '%s\n' "decode_step"
      ;;
    *)
      die "unknown profile target: ${target}"
      ;;
  esac
}

profile_strategy() {
  local target=$1

  case "${target}" in
    memory-vector-add-float32)
      printf '%s\n' "triton-block-size"
      ;;
    memory-reduction-iterative-float32)
      printf '%s\n' "triton-reduction-iterative"
      ;;
    memory-reduction-two-pass-float32)
      printf '%s\n' "triton-reduction-two-pass"
      ;;
    norms-rmsnorm-float16)
      printf '%s\n' "triton-fused-rmsnorm"
      ;;
    matmul-tiled-float16)
      printf '%s\n' "triton-tiled-dot-block-64x64x32-warps-4-stages-3"
      ;;
    matmul-tensor-core-float16|matmul-tensor-core-bfloat16)
      printf '%s\n' "triton-tiled-dot-block-128x128x64-warps-4-stages-4"
      ;;
    matmul-llm-up-bfloat16|matmul-llm-down-bfloat16)
      printf '%s\n' "triton-tiled-dot-block-128x128x64-warps-4-stages-4"
      ;;
    decode-step-naive-eager-float16)
      printf '%s\n' "naive-eager"
      ;;
    decode-step-fused-eager-float16)
      printf '%s\n' "fused-eager"
      ;;
    decode-step-naive-graph-float16)
      printf '%s\n' "naive-graph"
      ;;
    decode-step-fused-graph-float16)
      printf '%s\n' "fused-graph"
      ;;
    decode-step-fused-piecewise-graph-float16)
      printf '%s\n' "fused-piecewise-graph"
      ;;
    decode-step-fused-piecewise-graph-same-stream-float16)
      printf '%s\n' "fused-piecewise-graph-same-stream"
      ;;
    decode-step-dynamic-eager-float16)
      printf '%s\n' "dynamic-eager"
      ;;
    decode-step-dynamic-piecewise-graph-float16)
      printf '%s\n' "dynamic-piecewise-graph"
      ;;
    decode-step-dynamic-piecewise-graph-same-stream-float16)
      printf '%s\n' "dynamic-piecewise-graph-same-stream"
      ;;
    *)
      die "unknown profile target: ${target}"
      ;;
  esac
}

profile_launch_skip() {
  local target=$1

  case "${target}" in
    memory-reduction-two-pass-float32)
      printf '%s\n' "10"
      ;;
    memory-vector-add-float32|memory-reduction-iterative-float32|norms-rmsnorm-float16|matmul-tiled-float16|matmul-tensor-core-float16|matmul-tensor-core-bfloat16|matmul-llm-up-bfloat16|matmul-llm-down-bfloat16|decode-step-naive-eager-float16|decode-step-fused-eager-float16|decode-step-naive-graph-float16|decode-step-fused-graph-float16|decode-step-fused-piecewise-graph-float16|decode-step-fused-piecewise-graph-same-stream-float16|decode-step-dynamic-eager-float16|decode-step-dynamic-piecewise-graph-float16|decode-step-dynamic-piecewise-graph-same-stream-float16)
      printf '%s\n' "5"
      ;;
    *)
      die "unknown profile target: ${target}"
      ;;
  esac
}

profile_case_command() {
  local target=$1
  local benchmark_cmd
  local benchmark_log
  local benchmark_with_log
  local csv_path
  local stderr_path
  local report_path
  local operation
  local strategy
  local title
  local launch_skip
  local quoted_benchmark_cmd
  local quoted_benchmark_with_log
  local quoted_title

  benchmark_cmd=$(profile_benchmark_command "${target}")
  benchmark_log="${PROFILE_EXPORT_DIR}/${target}.benchmark.txt"
  benchmark_with_log="${benchmark_cmd} > ${benchmark_log}"
  csv_path="${PROFILE_EXPORT_DIR}/${target}.csv"
  stderr_path="${PROFILE_EXPORT_DIR}/${target}.stderr.txt"
  report_path="${PROFILE_REPORT_DIR}/${target}.md"
  operation=$(profile_operation "${target}")
  strategy=$(profile_strategy "${target}")
  title=$(profile_title "${target}")
  launch_skip=$(profile_launch_skip "${target}")

  printf -v quoted_benchmark_cmd '%q' "${benchmark_cmd}"
  printf -v quoted_benchmark_with_log '%q' "${benchmark_with_log}"
  printf -v quoted_title '%q' "${title}"

  printf '%s' "printf '\\n==> profiling ${target}\\n'"
  printf '%s' " && if ( \${profile_timeout_runner} \${ncu_runner} HOME=\"\$HOME\" PATH=\"\$PATH\" \"\${ncu_bin}\" \${ncu_profile_args} --target-processes all --launch-skip ${launch_skip} --launch-count 1 --csv --page raw bash -lc ${quoted_benchmark_with_log} > ${csv_path} 2> ${stderr_path} || \${profile_timeout_runner} \${ncu_runner} HOME=\"\$HOME\" PATH=\"\$PATH\" \"\${ncu_bin}\" \${ncu_profile_args} --target-processes all --launch-skip ${launch_skip} --launch-count 1 --csv bash -lc ${quoted_benchmark_with_log} > ${csv_path} 2>> ${stderr_path} ); then"
  printf '%s' " uv run nsight-summary --input ${csv_path} --output ${report_path} --title ${quoted_title} --benchmark-command ${quoted_benchmark_cmd} --result-jsonl ${PROFILE_RESULT_DIR}/${target}.jsonl --operation ${operation} --strategy ${strategy};"
  printf '%s' " else printf '# %s\\n\\nStatus: profile command failed\\n\\n- Nsight CSV: \`%s\`\\n- Nsight stderr: \`%s\`\\n- Benchmark log: \`%s\`\\n' ${quoted_title} ${csv_path} ${stderr_path} ${benchmark_log} > ${report_path}; cat ${stderr_path} >&2; false; fi"
}

remote_profile_command() {
  local command
  local ncu_args
  local resolved_preset
  local target
  local targets

  ncu_args=$(profile_ncu_args)
  command="cd ~/${REMOTE_DIR}"
  command+=" && export PATH=\"\$HOME/.local/bin:\$PATH:/usr/local/cuda/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin\""
  if [[ -n "${GIT_COMMIT}" ]]; then
    command+=" && export CUDA_KERNEL_LAB_GIT_COMMIT=${GIT_COMMIT}"
  fi
  command+=" && export CUDA_KERNEL_LAB_GIT_DIRTY=${GIT_DIRTY}"
  command+=" && export CUDA_KERNEL_LAB_PROVIDER=${PLATFORM}"
  if [[ "${PLATFORM}" == "runpod" ]]; then
    if [[ -n "${RUNPOD_POD_ID}" ]]; then
      command+=" && export CUDA_KERNEL_LAB_PROVIDER_ID=$(shell_quote "${RUNPOD_POD_ID}")"
    fi
    if [[ -n "${RUNPOD_GPU_ID}" ]]; then
      command+=" && export CUDA_KERNEL_LAB_PROVIDER_GPU_ID=$(shell_quote "${RUNPOD_GPU_ID}")"
    fi
    if [[ -n "${RUNPOD_CLOUD_TYPE}" ]]; then
      command+=" && export CUDA_KERNEL_LAB_PROVIDER_CLOUD_TYPE=$(shell_quote "${RUNPOD_CLOUD_TYPE}")"
    fi
    if [[ -n "${RUNPOD_IMAGE}" ]]; then
      command+=" && export CUDA_KERNEL_LAB_PROVIDER_IMAGE=$(shell_quote "${RUNPOD_IMAGE}")"
    fi
    if [[ -n "${RUNPOD_TEMPLATE_ID}" ]]; then
      command+=" && export CUDA_KERNEL_LAB_PROVIDER_TEMPLATE_ID=$(shell_quote "${RUNPOD_TEMPLATE_ID}")"
    fi
    if [[ -n "${RUNPOD_DATA_CENTER_IDS}" ]]; then
      command+=" && export CUDA_KERNEL_LAB_PROVIDER_REGION=$(shell_quote "${RUNPOD_DATA_CENTER_IDS}")"
    fi
  elif [[ -n "${INSTANCE_ID}" ]]; then
    command+=" && export CUDA_KERNEL_LAB_PROVIDER_ID=$(shell_quote "${INSTANCE_ID}")"
  fi
  command+=" && mkdir -p ${PROFILE_RESULT_DIR} ${PROFILE_EXPORT_DIR} ${PROFILE_REPORT_DIR}"
  command+=" && profile_status=0"
  command+="; $(remote_ncu_finder_command)"
  command+="; ncu_bin=\$(find_ncu_bin || true)"
  command+="; if [ -z \"\${ncu_bin}\" ]; then printf '# Nsight Compute Profile\\n\\nStatus: ncu was not found on the remote host.\\n' > ${PROFILE_REPORT_DIR}/profile-error.md; exit 1; fi"
  command+="; if command -v sudo >/dev/null 2>&1 && sudo -n true >/dev/null 2>&1; then ncu_runner='sudo -n env'; elif [ \"\$(id -u)\" = '0' ]; then ncu_runner='env'; else printf '# Nsight Compute Profile\\n\\nStatus: passwordless sudo or root is required to access NVIDIA performance counters.\\n' > ${PROFILE_REPORT_DIR}/profile-error.md; exit 1; fi"
  command+="; ncu_profile_args=$(shell_quote "${ncu_args}")"
  command+="; profile_timeout_runner=''"
  if [[ "${PROFILE_TIMEOUT_SECONDS}" != "0" ]]; then
    command+="; if command -v timeout >/dev/null 2>&1; then profile_timeout_runner='timeout ${PROFILE_TIMEOUT_SECONDS}'; else printf 'warning: timeout command not found; profiling without per-target timeout\\n' >&2; fi"
  fi

  targets=()
  if [[ -n "${PROFILE_TARGETS}" ]]; then
    IFS=',' read -r -a targets <<< "${PROFILE_TARGETS}"
  else
    resolved_preset="${PROFILE_PRESET}"
    if [[ "${resolved_preset}" == "auto" ]]; then
      if [[ "${ONLY_DECODE_STEP}" == "1" ]]; then
        resolved_preset="decode"
      elif [[ "${SUITE}" == "h200-roofline" || "${SUITE}" == "h200-matmul-autotune" || "${SUITE}" == "tensor-core" ]]; then
        resolved_preset="matmul-gaps"
      else
        resolved_preset="broad"
      fi
    fi

    if [[ "${resolved_preset}" == "broad" && "${ONLY_DECODE_STEP}" != "1" ]]; then
      targets+=(
        memory-vector-add-float32
        memory-reduction-iterative-float32
        memory-reduction-two-pass-float32
        norms-rmsnorm-float16
        matmul-tiled-float16
      )
    fi
    if [[ "${resolved_preset}" == "matmul-gaps" || ( "${resolved_preset}" == "broad" && ( "${SUITE}" == "h200-roofline" || "${SUITE}" == "h200-matmul-autotune" || "${SUITE}" == "tensor-core" ) ) ]]; then
      targets+=(
        matmul-tensor-core-float16
        matmul-tensor-core-bfloat16
        matmul-llm-up-bfloat16
        matmul-llm-down-bfloat16
      )
    fi
    if [[ "${resolved_preset}" == "decode" || ( "${resolved_preset}" == "broad" && ( "${INCLUDE_DECODE_STEP}" == "1" || "${ONLY_DECODE_STEP}" == "1" ) ) ]]; then
      targets+=(
        decode-step-naive-eager-float16
        decode-step-fused-eager-float16
        decode-step-naive-graph-float16
        decode-step-fused-graph-float16
        decode-step-fused-piecewise-graph-float16
        decode-step-fused-piecewise-graph-same-stream-float16
        decode-step-dynamic-eager-float16
        decode-step-dynamic-piecewise-graph-float16
        decode-step-dynamic-piecewise-graph-same-stream-float16
      )
    fi
  fi

  for target in "${targets[@]}"; do
    command+="; $(profile_case_command "${target}") || profile_status=1"
  done
  command+="; exit \${profile_status}"

  printf '%s\n' "${command}"
}

print_plan() {
  local plan_ssh_host

  if [[ "${PLATFORM}" == "aws" ]]; then
    plan_ssh_host="${SSH_HOST:-<terraform ssh_host>}"
  else
    plan_ssh_host="${SSH_HOST:-<runpod ssh_host>}"
  fi
  if [[ "${DRY_RUN}" == "1" ]]; then
    if [[ "${PLATFORM}" == "aws" ]]; then
      plan_ssh_host="<terraform ssh_host>"
    else
      plan_ssh_host="${SSH_HOST:-<runpod ssh_host>}"
    fi
  fi

  printf '\nBenchmark plan:\n'
  if [[ "${DRY_RUN}" == "1" ]]; then
    printf '  Mode: dry run; no SSH or provider commands will run\n'
  fi
  printf '  Platform: %s\n' "${PLATFORM}"
  printf '  Run id: %s\n' "${RUN_ID}"
  if [[ "${PLATFORM}" == "aws" ]]; then
    printf '  Terraform: %s\n' "${TF_DIR}"
    if [[ -n "${TF_VARS_FILE}" ]]; then
      printf '  Terraform variables: %s\n' "${TF_VARS_FILE}"
    fi
  else
    if [[ -n "${RUNPOD_POD_ID}" ]]; then
      printf '  Runpod pod: %s\n' "${RUNPOD_POD_ID}"
    fi
    if [[ -n "${RUNPOD_GPU_ID}" ]]; then
      printf '  Runpod GPU: %s\n' "${RUNPOD_GPU_ID}"
    fi
    if [[ -n "${RUNPOD_CLOUD_TYPE}" ]]; then
      printf '  Runpod cloud: %s\n' "${RUNPOD_CLOUD_TYPE}"
    fi
  fi
  if [[ -f "${CONNECTION_FILE}" ]]; then
    printf '  Connection metadata: %s\n' "${CONNECTION_FILE}"
  fi
  if [[ -n "${AWS_PROFILE_NAME}" ]]; then
    printf '  AWS profile: %s\n' "${AWS_PROFILE_NAME}"
  fi
  printf '  SSH: %s@%s:%s\n' "${SSH_USER}" "${plan_ssh_host}" "${SSH_PORT}"
  printf '  SSH key file: %s\n' "${KEY_FILE}"
  printf '  Remote repo: ~/%s\n' "${REMOTE_DIR}"
  if [[ "${PROFILE_ONLY}" == "1" ]]; then
    printf '  Profile-only: enabled\n'
  else
    printf '  Raw results: %s\n' "${RESULT_DIR}"
    printf '  Report: %s\n' "${REPORT_PATH}"
  fi
  if [[ "${SUITE}" != "standard" ]]; then
    printf '  Benchmark suite: %s\n' "${SUITE}"
  fi
  if [[ "${INCLUDE_MATMUL_SWEEP}" == "1" ]]; then
    printf '  Matmul sweep: enabled\n'
  elif [[ "${INCLUDE_MATMUL}" == "1" ]]; then
    printf '  Matmul baseline: enabled\n'
  fi
  if [[ "${INCLUDE_RMSNORM_SHAPE_SWEEP}" == "1" ]]; then
    printf '  RMSNorm shape sweep: enabled\n'
  fi
  if [[ "${INCLUDE_ATTENTION_BASELINE}" == "1" ]]; then
    printf '  Attention baseline: enabled\n'
  fi
  if [[ "${ONLY_DECODE_STEP}" == "1" ]]; then
    printf '  Decode-only matrix: enabled\n'
  fi
  if [[ "${INCLUDE_DECODE_STEP}" == "1" ]]; then
    printf '  Decode-step graph benchmark: enabled\n'
  fi
  if [[ "${INCLUDE_DECODE_BUCKET_SWEEP}" == "1" ]]; then
    printf '  Decode-step bucket sweep: enabled\n'
  fi
  if [[ "${INCLUDE_DECODE_TAIL_SWEEP}" == "1" ]]; then
    printf '  Decode-step tail sweep: enabled\n'
    if [[ -n "${DECODE_TAIL_BUCKETS}" ]]; then
      printf '  Decode-step tail buckets: %s\n' "${DECODE_TAIL_BUCKETS}"
    fi
    if [[ -n "${DECODE_TAIL_ITERATIONS}" ]]; then
      printf '  Decode-step tail iterations: %s\n' "${DECODE_TAIL_ITERATIONS}"
    fi
    if [[ -n "${DECODE_TAIL_SEEDS}" ]]; then
      printf '  Decode-step tail seeds: %s\n' "${DECODE_TAIL_SEEDS}"
    fi
  fi
  if [[ -n "${DECODE_ATTENTION_BACKEND}" ]]; then
    printf '  Decode-step attention backend: %s\n' "${DECODE_ATTENTION_BACKEND}"
  fi
  if [[ -n "${DECODE_DYNAMIC_COPY_MODE}" ]]; then
    printf '  Decode-step dynamic copy mode: %s\n' "${DECODE_DYNAMIC_COPY_MODE}"
  fi
  if [[ -n "${DECODE_PIECEWISE_POST_MODE}" ]]; then
    printf '  Decode-step piecewise post mode: %s\n' "${DECODE_PIECEWISE_POST_MODE}"
  fi
  if [[ -n "${DECODE_ORCHESTRATION_TIMING}" ]]; then
    printf '  Decode-step orchestration timing: %s\n' "${DECODE_ORCHESTRATION_TIMING}"
  fi
  if [[ "${PROFILE}" == "1" ]]; then
    printf '  Profile mode: %s\n' "${PROFILE_MODE}"
    printf '  Profile preset: %s\n' "${PROFILE_PRESET}"
    printf '  Profile timeout seconds: %s\n' "${PROFILE_TIMEOUT_SECONDS}"
    if [[ -n "${PROFILE_TARGETS}" ]]; then
      printf '  Profile targets: %s\n' "${PROFILE_TARGETS}"
    fi
    printf '  Profile JSONL: %s\n' "${PROFILE_RESULT_DIR}"
    printf '  Nsight Compute exports: %s\n' "${PROFILE_EXPORT_DIR}"
    printf '  Profile summaries: %s\n' "${PROFILE_REPORT_DIR}"
  fi
  printf '  Source git commit: %s\n' "${GIT_COMMIT:-unknown}"
  printf '  Source git dirty: %s\n' "${GIT_DIRTY}"

  if [[ "${DRY_RUN}" == "1" ]]; then
    printf '\nCommands:\n'
    if [[ "${PLATFORM}" == "aws" ]]; then
      print_command terraform -chdir="${TF_DIR}" output -raw ssh_host
    fi
    if [[ "${PROFILE_ONLY}" != "1" ]]; then
      printf '  ssh -p %s %s@%s %q\n' "${SSH_PORT}" "${SSH_USER}" "${plan_ssh_host}" "$(remote_benchmark_command)"
    fi
    if [[ "${PROFILE}" == "1" ]]; then
      printf '  ssh -p %s %s@%s %q\n' "${SSH_PORT}" "${SSH_USER}" "${plan_ssh_host}" "$(remote_profile_preflight_command)"
      printf '  ssh -p %s %s@%s %q\n' "${SSH_PORT}" "${SSH_USER}" "${plan_ssh_host}" "$(remote_profile_command)"
    fi
  fi
}

configure_ssh_args() {
  mkdir -p "${STATE_DIR}"
  ssh_base_args=(
    -i "${KEY_FILE}"
    -p "${SSH_PORT}"
    -o StrictHostKeyChecking=accept-new
    -o UserKnownHostsFile="${STATE_DIR}/known_hosts"
    -o ConnectTimeout=10
    -o ServerAliveInterval=15
  )
}

ssh_remote() {
  # shellcheck disable=SC2029
  ssh "${ssh_base_args[@]}" "${SSH_USER}@${SSH_HOST}" "$@"
}

run_remote_benchmark() {
  print_stage "running benchmark matrix"
  ssh_remote "$(remote_benchmark_command)"
}

preflight_remote_profile() {
  [[ "${PROFILE}" == "1" ]] || return 0

  print_stage "checking Nsight Compute availability"
  ssh_remote "$(remote_profile_preflight_command)"
}

run_remote_profile() {
  [[ "${PROFILE}" == "1" ]] || return 0

  print_stage "running focused Nsight Compute profiles"
  ssh_remote "$(remote_profile_command)"
}

pull_benchmark_artifacts() {
  print_stage "copying benchmark artifacts back"
  mkdir -p "${REPO_ROOT}/${OUTPUT_ROOT}" "${REPO_ROOT}/${REPORT_ROOT}"
  ssh_remote "cd ~/${REMOTE_DIR} && tar -czf - ${RESULT_DIR} ${REPORT_PATH}" \
    | tar -xzf - -C "${REPO_ROOT}"
}

pull_profile_artifacts() {
  [[ "${PROFILE}" == "1" ]] || return 0

  print_stage "copying profiler artifacts back"
  mkdir -p "${REPO_ROOT}/${OUTPUT_ROOT}" "${REPO_ROOT}/profiling/nsight_compute" \
    "${REPO_ROOT}/profiling/reports"
  ssh_remote \
    "cd ~/${REMOTE_DIR} && tar -czf - ${PROFILE_RESULT_DIR} ${PROFILE_EXPORT_DIR} ${PROFILE_REPORT_DIR}" \
    | tar -xzf - -C "${REPO_ROOT}"
}

print_complete() {
  if [[ "${PROFILE_ONLY}" == "1" ]]; then
    printf '\nProfile complete:\n'
  else
    printf '\nBenchmark complete:\n'
  fi
  if [[ -n "${INSTANCE_ID}" ]]; then
    if [[ "${PLATFORM}" == "runpod" ]]; then
      printf '  Pod: %s (still running)\n' "${INSTANCE_ID}"
    else
      printf '  Instance: %s (still running)\n' "${INSTANCE_ID}"
    fi
  fi
  if [[ "${PROFILE_ONLY}" != "1" ]]; then
    printf '  Raw results: %s\n' "${RESULT_DIR}"
    printf '  Report: %s\n' "${REPORT_PATH}"
    if [[ "${SUITE}" == "h200-matmul-autotune" ]]; then
      printf '  Autotune manifest: %s\n' "${RESULT_DIR}/h200-matmul-best.json"
      printf '  Autotune summary: %s\n' "${RESULT_DIR}/h200-matmul-best.md"
    fi
  fi
  if [[ "${PROFILE}" == "1" ]]; then
    printf '  Profile JSONL: %s\n' "${PROFILE_RESULT_DIR}"
    printf '  Nsight Compute exports: %s\n' "${PROFILE_EXPORT_DIR}"
    printf '  Profile summaries: %s\n' "${PROFILE_REPORT_DIR}"
  fi
}

main() {
  local profile_status=0

  parse_args "$@"
  resolve_connection_default
  load_connection_metadata
  resolve_provider_defaults
  resolve_defaults
  validate_inputs
  collect_source_metadata

  if [[ "${DRY_RUN}" == "1" ]]; then
    print_plan
    return 0
  fi

  if [[ "${PLATFORM}" == "aws" ]]; then
    require_commands terraform ssh tar git
  else
    require_commands ssh tar git
  fi
  if [[ "${PLATFORM}" == "aws" && -n "${AWS_PROFILE_NAME}" ]]; then
    export AWS_PROFILE="${AWS_PROFILE_NAME}"
  fi

  load_outputs
  resolve_provider_defaults
  configure_ssh_args
  print_plan
  preflight_remote_profile
  if [[ "${PROFILE_ONLY}" != "1" ]]; then
    run_remote_benchmark
    pull_benchmark_artifacts
  fi
  if [[ "${PROFILE}" == "1" ]]; then
    run_remote_profile || profile_status=$?
    pull_profile_artifacts || profile_status=$?
  fi
  if [[ "${profile_status}" != "0" ]]; then
    printf 'error: one or more profile targets failed; copied available artifacts\n' >&2
    return "${profile_status}"
  fi
  print_complete
}

main "$@"
