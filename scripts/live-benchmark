#!/usr/bin/env bash

set -Eeuo pipefail

SCRIPT_DIR=$(cd -- "$(dirname "${BASH_SOURCE[0]}")" && pwd)
REPO_ROOT=$(cd -- "${SCRIPT_DIR}/.." && pwd)

die() {
  printf 'error: %s\n' "$*" >&2
  exit 1
}

print_stage() {
  printf '==> %s\n' "$1"
}

require_commands() {
  local missing=()
  local command_name

  for command_name in "$@"; do
    if ! command -v "${command_name}" >/dev/null 2>&1; then
      missing+=("${command_name}")
    fi
  done

  if ((${#missing[@]} > 0)); then
    die "missing required command(s): ${missing[*]}"
  fi
}

require_value() {
  local option=$1
  local value=${2:-}

  [[ -n "${value}" && "${value}" != --* ]] || die "${option} requires a value"
}

expand_path() {
  local path=$1
  local home_prefix

  printf -v home_prefix '%b' '\x7e/'

  if [[ "${path:0:2}" == "${home_prefix}" ]]; then
    printf '%s/%s\n' "${HOME}" "${path#~/}"
    return
  fi

  printf '%s\n' "${path}"
}

absolute_path() {
  local path
  path=$(expand_path "$1")

  if [[ "${path}" == /* ]]; then
    printf '%s\n' "${path}"
  else
    printf '%s/%s\n' "$(pwd -P)" "${path}"
  fi
}

AWS_REGION_NAME="${AWS_REGION:-us-west-2}"
AWS_PROFILE_NAME="${AWS_PROFILE:-}"
INSTANCE_TYPE="g5.xlarge"
INSTANCE_NAME=""
RUN_ID=""

KEY_NAME=""
KEY_FILE=""
CREATE_TEMP_KEY=0
TEMP_KEY_CREATED=0

SSH_USER="ubuntu"
REMOTE_DIR="cuda-kernel-lab"
OUTPUT_ROOT="experiments/results/aws-ec2"
REPORT_ROOT="experiments/reports/aws-ec2"
INCLUDE_MATMUL=0
PROFILE=0
DRY_RUN=0

TF_DIR=$(absolute_path "${CUDA_KERNEL_LAB_TF_DIR:-${REPO_ROOT}/infra/env/aws-gpu}")
STATE_DIR="${CUDA_KERNEL_LAB_AWS_STATE_DIR:-${REPO_ROOT}/.aws-gpu}"
WORK_DIR=""
TF_VARS_FILE=""

RESULT_DIR=""
REPORT_PATH=""
PROFILE_RESULT_DIR=""
PROFILE_EXPORT_DIR=""
PROFILE_REPORT_DIR=""
GIT_COMMIT=""
GIT_DIRTY="unknown"
SSH_HOST=""
INSTANCE_ID=""

TERRAFORM_TOUCHED=0
CLEANUP_DONE=0

ssh_base_args=()

usage() {
  cat <<EOF
Usage:
  ./scripts/live-benchmark [options]

Creates a disposable AWS EC2 GPU host, runs the live benchmark matrix, copies
JSONL results and a Markdown report back into a run-id layout, then tears down
the host and deletes any temporary EC2 key pair it created.

Options:
  --run-id <id>             Result run id. Default: UTC timestamp.
  --key-name <name>         Existing EC2 key pair name. Requires --key-file.
  --key-file <path>         Existing SSH private key. Requires --key-name.
  --profile <name>          AWS CLI profile used by AWS CLI and Terraform.
  --region <name>           AWS region. Default: ${AWS_REGION_NAME}
  --instance-type <type>    EC2 GPU instance. Default: ${INSTANCE_TYPE}
  --name <name>             EC2 Name tag. Default: cuda-kernel-lab-<run-id>
  --include-matmul          Include the tiled matmul progression in the matrix.
  --with-profiling          Capture focused Nsight Compute CSV and Markdown summaries.
  --output-root <path>      Raw JSONL root. Default: ${OUTPUT_ROOT}
  --report-root <path>      Markdown report root. Default: ${REPORT_ROOT}
  --ssh-user <name>         SSH user. Default: ${SSH_USER}
  --remote-dir <path>       Remote repo directory. Default: ${REMOTE_DIR}
  --tf-dir <path>           Terraform environment. Default: ${TF_DIR}
  --dry-run                 Print the planned workflow without touching AWS.

Examples:
  ./scripts/live-benchmark
  ./scripts/live-benchmark --run-id 2026-05-19-a10g-baseline
  ./scripts/live-benchmark --run-id 2026-05-19-a10g-profile --with-profiling
  ./scripts/live-benchmark --profile personal --instance-type g6.xlarge --include-matmul
  ./scripts/live-benchmark --key-name kernel-lab --key-file ~/.ssh/kernel-lab.pem
EOF
}

parse_args() {
  while (($# > 0)); do
    case "$1" in
      -h|--help)
        usage
        exit 0
        ;;
      --run-id)
        require_value "$1" "${2:-}"
        RUN_ID=${2:-}
        shift 2
        ;;
      --key-name)
        require_value "$1" "${2:-}"
        KEY_NAME=${2:-}
        shift 2
        ;;
      --key-file)
        require_value "$1" "${2:-}"
        KEY_FILE=$(absolute_path "${2:-}")
        shift 2
        ;;
      --profile)
        require_value "$1" "${2:-}"
        AWS_PROFILE_NAME=${2:-}
        shift 2
        ;;
      --region)
        require_value "$1" "${2:-}"
        AWS_REGION_NAME=${2:-}
        shift 2
        ;;
      --instance-type)
        require_value "$1" "${2:-}"
        INSTANCE_TYPE=${2:-}
        shift 2
        ;;
      --name)
        require_value "$1" "${2:-}"
        INSTANCE_NAME=${2:-}
        shift 2
        ;;
      --include-matmul)
        INCLUDE_MATMUL=1
        shift
        ;;
      --output-root)
        require_value "$1" "${2:-}"
        OUTPUT_ROOT=${2:-}
        shift 2
        ;;
      --report-root)
        require_value "$1" "${2:-}"
        REPORT_ROOT=${2:-}
        shift 2
        ;;
      --ssh-user)
        require_value "$1" "${2:-}"
        SSH_USER=${2:-}
        shift 2
        ;;
      --remote-dir)
        require_value "$1" "${2:-}"
        REMOTE_DIR=${2:-}
        shift 2
        ;;
      --tf-dir)
        require_value "$1" "${2:-}"
        TF_DIR=$(absolute_path "${2:-}")
        shift 2
        ;;
      --dry-run)
        DRY_RUN=1
        shift
        ;;
      --with-profiling)
        PROFILE=1
        shift
        ;;
      *)
        die "unknown argument: $1"
        ;;
    esac
  done
}

validate_slug() {
  local label=$1
  local value=$2

  [[ "${value}" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || {
    die "${label} must use only letters, numbers, dots, underscores, and dashes"
  }
}

validate_relative_path() {
  local label=$1
  local value=$2

  [[ "${value}" =~ ^[A-Za-z0-9._/-]+$ ]] || die "${label} contains unsafe characters"
  [[ "${value}" != /* && "${value}" != *..* ]] || {
    die "${label} must be a relative path without '..'"
  }
  [[ "${value}" != "." && "${value}" != .* && "${value}" != */.* ]] || {
    die "${label} must not target hidden or current-directory paths"
  }
}

resolve_defaults() {
  if [[ -z "${RUN_ID}" ]]; then
    RUN_ID=$(date -u +%Y%m%dT%H%M%SZ)
  fi
  validate_slug "--run-id" "${RUN_ID}"

  WORK_DIR="${STATE_DIR}/live-benchmark"
  TF_VARS_FILE="${WORK_DIR}/${RUN_ID}.auto.tfvars"
  RESULT_DIR="${OUTPUT_ROOT}/${RUN_ID}"
  REPORT_PATH="${REPORT_ROOT}/${RUN_ID}.md"
  PROFILE_RESULT_DIR="${OUTPUT_ROOT}/${RUN_ID}-profiled"
  PROFILE_EXPORT_DIR="profiling/nsight_compute/${RUN_ID}"
  PROFILE_REPORT_DIR="profiling/reports/${RUN_ID}"

  if [[ -z "${INSTANCE_NAME}" ]]; then
    INSTANCE_NAME="cuda-kernel-lab-${RUN_ID}"
  fi

  if [[ -z "${KEY_NAME}" && -z "${KEY_FILE}" ]]; then
    CREATE_TEMP_KEY=1
    KEY_NAME="cuda-kernel-lab-${RUN_ID}"
    KEY_FILE="${WORK_DIR}/${RUN_ID}.pem"
  elif [[ -n "${KEY_NAME}" && -n "${KEY_FILE}" ]]; then
    CREATE_TEMP_KEY=0
  else
    die "--key-name and --key-file must be provided together"
  fi
}

validate_inputs() {
  [[ -d "${TF_DIR}" ]] || die "Terraform directory does not exist: ${TF_DIR}"
  [[ "${SSH_USER}" =~ ^[A-Za-z_][A-Za-z0-9_.-]*[$]?$ ]] || die "--ssh-user contains unsafe characters"
  validate_relative_path "--remote-dir" "${REMOTE_DIR}"
  validate_relative_path "--output-root" "${OUTPUT_ROOT}"
  validate_relative_path "--report-root" "${REPORT_ROOT}"
  validate_relative_path "profile export directory" "${PROFILE_EXPORT_DIR}"
  validate_relative_path "profile report directory" "${PROFILE_REPORT_DIR}"

  if [[ "${CREATE_TEMP_KEY}" == "0" && ! -f "${KEY_FILE}" ]]; then
    die "SSH key file does not exist: ${KEY_FILE}"
  fi

  if [[ "${DRY_RUN}" == "0" ]]; then
    [[ ! -e "${REPO_ROOT}/${RESULT_DIR}" ]] || die "result directory already exists: ${RESULT_DIR}"
    [[ ! -e "${REPO_ROOT}/${REPORT_PATH}" ]] || die "report already exists: ${REPORT_PATH}"
    if [[ "${PROFILE}" == "1" ]]; then
      [[ ! -e "${REPO_ROOT}/${PROFILE_RESULT_DIR}" ]] || {
        die "profile result directory already exists: ${PROFILE_RESULT_DIR}"
      }
      [[ ! -e "${REPO_ROOT}/${PROFILE_EXPORT_DIR}" ]] || {
        die "profile export directory already exists: ${PROFILE_EXPORT_DIR}"
      }
      [[ ! -e "${REPO_ROOT}/${PROFILE_REPORT_DIR}" ]] || {
        die "profile report directory already exists: ${PROFILE_REPORT_DIR}"
      }
    fi
  fi
}

collect_source_metadata() {
  GIT_COMMIT=$(git -C "${REPO_ROOT}" rev-parse HEAD 2>/dev/null || true)

  local status
  if status=$(git -C "${REPO_ROOT}" status --short 2>/dev/null); then
    if [[ -n "${status}" ]]; then
      GIT_DIRTY="true"
    else
      GIT_DIRTY="false"
    fi
  fi
}

print_command() {
  printf '  '
  printf '%q ' "$@"
  printf '\n'
}

up_command() {
  local -a cmd
  cmd=(
    "${REPO_ROOT}/scripts/up"
    --key-name "${KEY_NAME}"
    --key-file "${KEY_FILE}"
    --region "${AWS_REGION_NAME}"
    --instance-type "${INSTANCE_TYPE}"
    --name "${INSTANCE_NAME}"
    --tf-dir "${TF_DIR}"
    --tf-vars-file "${TF_VARS_FILE}"
  )
  if [[ -n "${AWS_PROFILE_NAME}" ]]; then
    cmd+=(--profile "${AWS_PROFILE_NAME}")
  fi
  printf '%s\0' "${cmd[@]}"
}

down_command() {
  local -a cmd
  cmd=(
    "${REPO_ROOT}/scripts/down"
    --region "${AWS_REGION_NAME}"
    --tf-dir "${TF_DIR}"
    --tf-vars-file "${TF_VARS_FILE}"
    --remove-tfvars
  )
  if [[ -n "${AWS_PROFILE_NAME}" ]]; then
    cmd+=(--profile "${AWS_PROFILE_NAME}")
  fi
  printf '%s\0' "${cmd[@]}"
}

remote_benchmark_command() {
  local command

  command="cd ~/${REMOTE_DIR}"
  command+=" && export PATH=\"\$HOME/.local/bin:\$PATH\""
  if [[ -n "${GIT_COMMIT}" ]]; then
    command+=" && export CUDA_KERNEL_LAB_GIT_COMMIT=${GIT_COMMIT}"
  fi
  command+=" && export CUDA_KERNEL_LAB_GIT_DIRTY=${GIT_DIRTY}"
  command+=" && uv run benchmark-matrix --output-dir ${RESULT_DIR}"
  command+=" --include-vector-add-sweep --include-reduction-sweep"
  if [[ "${INCLUDE_MATMUL}" == "1" ]]; then
    command+=" --include-matmul"
  fi
  command+=" && uv run benchmark-report --input-dir ${RESULT_DIR} --output ${REPORT_PATH}"

  printf '%s\n' "${command}"
}

profile_benchmark_command() {
  local target=$1

  case "${target}" in
    memory-vector-add-float32)
      printf '%s\n' \
        "uv run benchmark-memory --backend triton --device cuda --op vector_add --numel 16777216 --dtype float32 --block-size 1024 --warmup 5 --iterations 10 --skip-correctness --output ${PROFILE_RESULT_DIR}/memory-vector-add-float32.jsonl"
      ;;
    memory-reduction-iterative-float32)
      printf '%s\n' \
        "uv run benchmark-memory --backend triton --device cuda --op reduction_sum --numel 16777216 --dtype float32 --block-size 1024 --reduction-strategy iterative --warmup 5 --iterations 10 --skip-correctness --output ${PROFILE_RESULT_DIR}/memory-reduction-iterative-float32.jsonl"
      ;;
    memory-reduction-two-pass-float32)
      printf '%s\n' \
        "uv run benchmark-memory --backend triton --device cuda --op reduction_sum --numel 16777216 --dtype float32 --block-size 1024 --reduction-strategy two_pass --warmup 5 --iterations 10 --skip-correctness --output ${PROFILE_RESULT_DIR}/memory-reduction-two-pass-float32.jsonl"
      ;;
    norms-rmsnorm-float16)
      printf '%s\n' \
        "uv run benchmark-norms --backend triton --device cuda --op rmsnorm --rows 4096 --cols 4096 --dtype float16 --warmup 5 --iterations 10 --skip-correctness --output ${PROFILE_RESULT_DIR}/norms-rmsnorm-float16.jsonl"
      ;;
    *)
      die "unknown profile target: ${target}"
      ;;
  esac
}

profile_title() {
  local target=$1

  case "${target}" in
    memory-vector-add-float32)
      printf '%s\n' "A10G vector_add float32 profile"
      ;;
    memory-reduction-iterative-float32)
      printf '%s\n' "A10G reduction_sum iterative float32 profile"
      ;;
    memory-reduction-two-pass-float32)
      printf '%s\n' "A10G reduction_sum two-pass float32 profile"
      ;;
    norms-rmsnorm-float16)
      printf '%s\n' "A10G RMSNorm float16 profile"
      ;;
    *)
      die "unknown profile target: ${target}"
      ;;
  esac
}

profile_operation() {
  local target=$1

  case "${target}" in
    memory-vector-add-float32)
      printf '%s\n' "vector_add"
      ;;
    memory-reduction-iterative-float32|memory-reduction-two-pass-float32)
      printf '%s\n' "reduction_sum"
      ;;
    norms-rmsnorm-float16)
      printf '%s\n' "rmsnorm"
      ;;
    *)
      die "unknown profile target: ${target}"
      ;;
  esac
}

profile_strategy() {
  local target=$1

  case "${target}" in
    memory-vector-add-float32)
      printf '%s\n' "triton-block-size"
      ;;
    memory-reduction-iterative-float32)
      printf '%s\n' "triton-reduction-iterative"
      ;;
    memory-reduction-two-pass-float32)
      printf '%s\n' "triton-reduction-two-pass"
      ;;
    norms-rmsnorm-float16)
      printf '%s\n' "triton-fused-rmsnorm"
      ;;
    *)
      die "unknown profile target: ${target}"
      ;;
  esac
}

profile_launch_skip() {
  local target=$1

  case "${target}" in
    memory-reduction-two-pass-float32)
      printf '%s\n' "10"
      ;;
    memory-vector-add-float32|memory-reduction-iterative-float32|norms-rmsnorm-float16)
      printf '%s\n' "5"
      ;;
    *)
      die "unknown profile target: ${target}"
      ;;
  esac
}

profile_case_command() {
  local target=$1
  local benchmark_cmd
  local benchmark_log
  local benchmark_with_log
  local csv_path
  local stderr_path
  local report_path
  local operation
  local strategy
  local title
  local launch_skip
  local quoted_benchmark_cmd
  local quoted_benchmark_with_log
  local quoted_title

  benchmark_cmd=$(profile_benchmark_command "${target}")
  benchmark_log="${PROFILE_EXPORT_DIR}/${target}.benchmark.txt"
  benchmark_with_log="${benchmark_cmd} > ${benchmark_log}"
  csv_path="${PROFILE_EXPORT_DIR}/${target}.csv"
  stderr_path="${PROFILE_EXPORT_DIR}/${target}.stderr.txt"
  report_path="${PROFILE_REPORT_DIR}/${target}.md"
  operation=$(profile_operation "${target}")
  strategy=$(profile_strategy "${target}")
  title=$(profile_title "${target}")
  launch_skip=$(profile_launch_skip "${target}")

  printf -v quoted_benchmark_cmd '%q' "${benchmark_cmd}"
  printf -v quoted_benchmark_with_log '%q' "${benchmark_with_log}"
  printf -v quoted_title '%q' "${title}"

  printf '%s' "printf '\\n==> profiling ${target}\\n'"
  printf '%s' " && if ( sudo -n env HOME=\"\$HOME\" PATH=\"\$PATH\" \"\${ncu_bin}\" --set full --target-processes all --launch-skip ${launch_skip} --launch-count 1 --csv --page raw bash -lc ${quoted_benchmark_with_log} > ${csv_path} 2> ${stderr_path} || sudo -n env HOME=\"\$HOME\" PATH=\"\$PATH\" \"\${ncu_bin}\" --set full --target-processes all --launch-skip ${launch_skip} --launch-count 1 --csv bash -lc ${quoted_benchmark_with_log} > ${csv_path} 2>> ${stderr_path} ); then"
  printf '%s' " uv run nsight-summary --input ${csv_path} --output ${report_path} --title ${quoted_title} --benchmark-command ${quoted_benchmark_cmd} --result-jsonl ${PROFILE_RESULT_DIR}/${target}.jsonl --operation ${operation} --strategy ${strategy};"
  printf '%s' " else printf '# %s\\n\\nStatus: profile command failed\\n\\n- Nsight CSV: \`%s\`\\n- Nsight stderr: \`%s\`\\n- Benchmark log: \`%s\`\\n' ${quoted_title} ${csv_path} ${stderr_path} ${benchmark_log} > ${report_path}; cat ${stderr_path} >&2; false; fi"
}

remote_profile_command() {
  local command
  local target

  command="cd ~/${REMOTE_DIR}"
  command+=" && export PATH=\"\$HOME/.local/bin:\$PATH\""
  if [[ -n "${GIT_COMMIT}" ]]; then
    command+=" && export CUDA_KERNEL_LAB_GIT_COMMIT=${GIT_COMMIT}"
  fi
  command+=" && export CUDA_KERNEL_LAB_GIT_DIRTY=${GIT_DIRTY}"
  command+=" && mkdir -p ${PROFILE_RESULT_DIR} ${PROFILE_EXPORT_DIR} ${PROFILE_REPORT_DIR}"
  command+=" && profile_status=0"
  command+=" && ncu_bin=\$(command -v ncu || true)"
  command+="; if [ -z \"\${ncu_bin}\" ]; then printf '# Nsight Compute Profile\\n\\nStatus: ncu was not found on the remote host.\\n' > ${PROFILE_REPORT_DIR}/profile-error.md; exit 1; fi"
  command+="; if ! sudo -n true >/dev/null 2>&1; then printf '# Nsight Compute Profile\\n\\nStatus: passwordless sudo is required to access NVIDIA performance counters.\\n' > ${PROFILE_REPORT_DIR}/profile-error.md; exit 1; fi"

  for target in \
    memory-vector-add-float32 \
    memory-reduction-iterative-float32 \
    memory-reduction-two-pass-float32 \
    norms-rmsnorm-float16; do
    command+="; $(profile_case_command "${target}") || profile_status=1"
  done
  command+="; exit \${profile_status}"

  printf '%s\n' "${command}"
}

print_plan() {
  printf '\nLive benchmark plan:\n'
  if [[ "${DRY_RUN}" == "1" ]]; then
    printf '  Mode: dry run; no AWS or Terraform commands will run\n'
  fi
  printf '  Run id: %s\n' "${RUN_ID}"
  printf '  Region: %s\n' "${AWS_REGION_NAME}"
  if [[ -n "${AWS_PROFILE_NAME}" ]]; then
    printf '  AWS profile: %s\n' "${AWS_PROFILE_NAME}"
  fi
  printf '  Instance: %s\n' "${INSTANCE_TYPE}"
  if [[ "${CREATE_TEMP_KEY}" == "1" ]]; then
    printf '  EC2 key pair: temporary %s\n' "${KEY_NAME}"
    printf '  Local private key: %s (deleted after run)\n' "${KEY_FILE}"
  else
    printf '  EC2 key pair: existing %s\n' "${KEY_NAME}"
    printf '  Local private key: %s (left untouched)\n' "${KEY_FILE}"
  fi
  printf '  Terraform variables: %s\n' "${TF_VARS_FILE}"
  printf '  Raw results: %s\n' "${RESULT_DIR}"
  printf '  Report: %s\n' "${REPORT_PATH}"
  if [[ "${PROFILE}" == "1" ]]; then
    printf '  Profile JSONL: %s\n' "${PROFILE_RESULT_DIR}"
    printf '  Nsight Compute exports: %s\n' "${PROFILE_EXPORT_DIR}"
    printf '  Profile summaries: %s\n' "${PROFILE_REPORT_DIR}"
  fi
  printf '  Source git commit: %s\n' "${GIT_COMMIT:-unknown}"
  printf '  Source git dirty: %s\n' "${GIT_DIRTY}"

  if [[ "${DRY_RUN}" == "1" ]]; then
    printf '\nCommands:\n'
    local -a up_cmd
    mapfile -d '' -t up_cmd < <(up_command)
    print_command "${up_cmd[@]}"
    printf '  ssh %s@<host> %q\n' "${SSH_USER}" "$(remote_benchmark_command)"
    if [[ "${PROFILE}" == "1" ]]; then
      printf '  ssh %s@<host> %q\n' "${SSH_USER}" "$(remote_profile_command)"
    fi
    local -a down_cmd
    mapfile -d '' -t down_cmd < <(down_command)
    print_command "${down_cmd[@]}"
  fi
}

ensure_empty_terraform_state() {
  local state_resources

  print_stage "checking Terraform state"
  terraform -chdir="${TF_DIR}" init -input=false
  state_resources=$(terraform -chdir="${TF_DIR}" state list 2>/dev/null || true)
  [[ -z "${state_resources}" ]] || {
    printf '%s\n' "${state_resources}" >&2
    die "Terraform state is not empty; run ./scripts/down or use a clean state before live-benchmark"
  }
}

create_temp_key_pair() {
  [[ "${CREATE_TEMP_KEY}" == "1" ]] || return 0

  print_stage "creating temporary EC2 key pair"
  mkdir -p "${WORK_DIR}"
  if ! aws ec2 create-key-pair \
    --key-name "${KEY_NAME}" \
    --region "${AWS_REGION_NAME}" \
    --query KeyMaterial \
    --output text > "${KEY_FILE}"; then
    rm -f "${KEY_FILE}"
    die "failed to create temporary EC2 key pair: ${KEY_NAME}"
  fi
  TEMP_KEY_CREATED=1
  chmod 600 "${KEY_FILE}"
}

configure_ssh_args() {
  mkdir -p "${STATE_DIR}"
  ssh_base_args=(
    -i "${KEY_FILE}"
    -o StrictHostKeyChecking=accept-new
    -o UserKnownHostsFile="${STATE_DIR}/known_hosts"
    -o ConnectTimeout=10
    -o ServerAliveInterval=15
  )
}

ssh_remote() {
  # shellcheck disable=SC2029
  ssh "${ssh_base_args[@]}" "${SSH_USER}@${SSH_HOST}" "$@"
}

load_outputs() {
  INSTANCE_ID=$(terraform -chdir="${TF_DIR}" output -raw instance_id)
  SSH_HOST=$(terraform -chdir="${TF_DIR}" output -raw ssh_host)
}

run_up() {
  local -a cmd
  mapfile -d '' -t cmd < <(up_command)

  print_stage "provisioning GPU host"
  TERRAFORM_TOUCHED=1
  "${cmd[@]}"
}

run_remote_benchmark() {
  print_stage "running live benchmark matrix"
  ssh_remote "$(remote_benchmark_command)"
}

run_remote_profile() {
  [[ "${PROFILE}" == "1" ]] || return 0

  print_stage "running focused Nsight Compute profiles"
  ssh_remote "$(remote_profile_command)"
}

pull_benchmark_artifacts() {
  print_stage "copying benchmark artifacts back"
  mkdir -p "${REPO_ROOT}/${OUTPUT_ROOT}" "${REPO_ROOT}/${REPORT_ROOT}"
  ssh_remote "cd ~/${REMOTE_DIR} && tar -czf - ${RESULT_DIR} ${REPORT_PATH}" \
    | tar -xzf - -C "${REPO_ROOT}"
}

pull_profile_artifacts() {
  [[ "${PROFILE}" == "1" ]] || return 0

  print_stage "copying profiler artifacts back"
  mkdir -p "${REPO_ROOT}/${OUTPUT_ROOT}" "${REPO_ROOT}/profiling/nsight_compute" \
    "${REPO_ROOT}/profiling/reports"
  ssh_remote \
    "cd ~/${REMOTE_DIR} && tar -czf - ${PROFILE_RESULT_DIR} ${PROFILE_EXPORT_DIR} ${PROFILE_REPORT_DIR}" \
    | tar -xzf - -C "${REPO_ROOT}"
}

cleanup_resources() {
  local cleanup_status=0

  if [[ "${CLEANUP_DONE}" == "1" ]]; then
    return 0
  fi
  CLEANUP_DONE=1

  set +e

  if [[ "${TERRAFORM_TOUCHED}" == "1" ]]; then
    local -a cmd
    mapfile -d '' -t cmd < <(down_command)
    print_stage "tearing down GPU host"
    "${cmd[@]}" || cleanup_status=1
  fi

  if [[ "${TEMP_KEY_CREATED}" == "1" ]]; then
    print_stage "deleting temporary EC2 key pair"
    aws ec2 delete-key-pair \
      --key-name "${KEY_NAME}" \
      --region "${AWS_REGION_NAME}" >/dev/null || cleanup_status=1
    rm -f "${KEY_FILE}" || cleanup_status=1
  fi

  set -e
  return "${cleanup_status}"
}

cleanup_trap() {
  local status=$?
  local cleanup_status=0

  cleanup_resources || cleanup_status=$?
  if [[ "${status}" == "0" && "${cleanup_status}" != "0" ]]; then
    status=${cleanup_status}
  fi
  exit "${status}"
}

print_complete() {
  printf '\nLive benchmark complete:\n'
  printf '  Instance: %s (terminated)\n' "${INSTANCE_ID}"
  printf '  Raw results: %s\n' "${RESULT_DIR}"
  printf '  Report: %s\n' "${REPORT_PATH}"
  if [[ "${PROFILE}" == "1" ]]; then
    printf '  Profile JSONL: %s\n' "${PROFILE_RESULT_DIR}"
    printf '  Nsight Compute exports: %s\n' "${PROFILE_EXPORT_DIR}"
    printf '  Profile summaries: %s\n' "${PROFILE_REPORT_DIR}"
  fi
  if [[ "${TEMP_KEY_CREATED}" == "1" ]]; then
    printf '  EC2 key pair deleted: %s\n' "${KEY_NAME}"
    printf '  Local private key removed: %s\n' "${KEY_FILE}"
  fi
}

main() {
  local profile_status=0

  parse_args "$@"
  resolve_defaults
  validate_inputs
  collect_source_metadata
  print_plan

  if [[ "${DRY_RUN}" == "1" ]]; then
    return 0
  fi

  require_commands aws terraform ssh tar git
  if [[ -n "${AWS_PROFILE_NAME}" ]]; then
    export AWS_PROFILE="${AWS_PROFILE_NAME}"
  fi

  ensure_empty_terraform_state
  trap cleanup_trap EXIT

  create_temp_key_pair
  run_up
  load_outputs
  configure_ssh_args
  run_remote_benchmark
  pull_benchmark_artifacts
  if [[ "${PROFILE}" == "1" ]]; then
    run_remote_profile || profile_status=$?
    pull_profile_artifacts || profile_status=$?
  fi
  cleanup_resources
  trap - EXIT
  if [[ "${profile_status}" != "0" ]]; then
    printf 'error: one or more profile targets failed; copied available artifacts before teardown\n' >&2
    return "${profile_status}"
  fi
  print_complete
}

main "$@"
