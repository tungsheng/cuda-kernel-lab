#!/usr/bin/env bash

set -Eeuo pipefail

SCRIPT_DIR=$(cd -- "$(dirname "${BASH_SOURCE[0]}")" && pwd)
REPO_ROOT=$(cd -- "${SCRIPT_DIR}/.." && pwd)

die() {
  printf 'error: %s\n' "$*" >&2
  exit 1
}

print_stage() {
  printf '==> %s\n' "$1"
}

require_commands() {
  local missing=()
  local command_name

  for command_name in "$@"; do
    if ! command -v "${command_name}" >/dev/null 2>&1; then
      missing+=("${command_name}")
    fi
  done

  if ((${#missing[@]} > 0)); then
    die "missing required command(s): ${missing[*]}"
  fi
}

require_value() {
  local option=$1
  local value=${2:-}

  [[ -n "${value}" && "${value}" != --* ]] || die "${option} requires a value"
}

expand_path() {
  local path=$1
  local home_prefix

  printf -v home_prefix '%b' '\x7e/'

  if [[ "${path:0:2}" == "${home_prefix}" ]]; then
    printf '%s/%s\n' "${HOME}" "${path#~/}"
    return
  fi

  printf '%s\n' "${path}"
}

absolute_path() {
  local path
  path=$(expand_path "$1")

  if [[ "${path}" == /* ]]; then
    printf '%s\n' "${path}"
  else
    printf '%s/%s\n' "$(pwd -P)" "${path}"
  fi
}

shell_quote() {
  printf '%q' "$1"
}

STATE_DIR=$(absolute_path "${CUDA_KERNEL_LAB_RUNPOD_STATE_DIR:-${REPO_ROOT}/.runpod}")
KEY_DIR="${STATE_DIR}/keys"
CONNECTION_FILE="${CUDA_KERNEL_LAB_CONNECTION_FILE:-${STATE_DIR}/connection.env}"

RUNPOD_GPU_ID="${CUDA_KERNEL_LAB_RUNPOD_GPU_ID:-NVIDIA L4}"
RUNPOD_GPU_COUNT=1
RUNPOD_CLOUD_TYPE="${CUDA_KERNEL_LAB_RUNPOD_CLOUD_TYPE:-SECURE}"
RUNPOD_CLOUD_TYPE_SET=0
if [[ -n "${CUDA_KERNEL_LAB_RUNPOD_CLOUD_TYPE:-}" ]]; then
  RUNPOD_CLOUD_TYPE_SET=1
fi
RUNPOD_IMAGE="${CUDA_KERNEL_LAB_RUNPOD_IMAGE:-runpod/pytorch:1.0.3-cu1281-torch291-ubuntu2404}"
RUNPOD_TEMPLATE_ID="${CUDA_KERNEL_LAB_RUNPOD_TEMPLATE_ID:-}"
RUNPOD_CONTAINER_DISK_GB=60
RUNPOD_VOLUME_GB=60
RUNPOD_NETWORK_VOLUME_ID="${CUDA_KERNEL_LAB_RUNPOD_NETWORK_VOLUME_ID:-}"
RUNPOD_DATA_CENTER_IDS="${CUDA_KERNEL_LAB_RUNPOD_DATA_CENTER_IDS:-}"
RUNPOD_TERMINATE_AFTER="${CUDA_KERNEL_LAB_RUNPOD_TERMINATE_AFTER:-}"
RUNPOD_INSTALL_NCU="${CUDA_KERNEL_LAB_RUNPOD_INSTALL_NCU:-1}"
RUNPOD_PROFILE_COUNTERS="${CUDA_KERNEL_LAB_RUNPOD_PROFILE_COUNTERS:-0}"
RUNPOD_NAME="cuda-kernel-lab-gpu"
RUNPOD_VOLUME_MOUNT_PATH="/workspace"
RUNPOD_DOCKER_ARGS="${CUDA_KERNEL_LAB_RUNPOD_DOCKER_ARGS:-}"

KEY_FILE=""
SSH_USER="root"
SSH_HOST=""
SSH_PORT="22"
REMOTE_DIR="cuda-kernel-lab"
SKIP_BOOTSTRAP=0
DRY_RUN=0

RUNPOD_POD_ID=""
RUNPOD_CREATE_ARGS=()

usage() {
  cat <<EOF
Usage:
  ./scripts/up [--platform runpod] [options]

Creates one disposable Runpod GPU Pod for CUDA benchmark runs, then syncs this
repo and bootstraps the benchmark environment.

Options:
  --platform runpod              Select the Runpod provider. Default: runpod.
  --gpu-id <id>                  Runpod GPU id. Default: ${RUNPOD_GPU_ID}
  --gpu-count <n>                Number of GPUs. Default: ${RUNPOD_GPU_COUNT}
  --cloud-type <type>            SECURE or COMMUNITY. Default: ${RUNPOD_CLOUD_TYPE}
  --image <image>                Docker image. Default: ${RUNPOD_IMAGE}
  --template-id <id>             Runpod template id. Overrides --image when set.
  --container-disk-gb <gb>       Container disk size. Default: ${RUNPOD_CONTAINER_DISK_GB}
  --volume-gb <gb>               Persistent Pod volume size. Default: ${RUNPOD_VOLUME_GB}
  --network-volume-id <id>       Attach an existing Runpod network volume.
  --data-center-ids <csv>        Preferred Runpod datacenter ids.
  --terminate-after <value>      Pass-through auto-terminate value for runpodctl.
  --install-nsight-compute       Install and validate ncu during bootstrap. Default.
  --no-install-nsight-compute    Skip Nsight Compute install for benchmark-only Pods.
  --profile-counters             Validate Nsight counter access during bootstrap.
                                  Defaults to COMMUNITY cloud unless --cloud-type is set.
  --name <name>                  Pod name. Default: ${RUNPOD_NAME}
  --docker-args <args>           Optional container command arguments.
  --key-file <path>              SSH private key. Default: .runpod/keys/<name>
  --ssh-user <name>              SSH user. Default: ${SSH_USER}
  --remote-dir <path>            Remote repo directory. Default: ${REMOTE_DIR}
  --skip-bootstrap               Create the Pod only; do not SSH, sync, or install dependencies.
  --connection-file <path>       Connection metadata path. Default: ${CONNECTION_FILE}
  --dry-run                      Print the Runpod launch configuration without creating a Pod.

Examples:
  ./scripts/up
  ./scripts/up --gpu-id "NVIDIA RTX 4090" --terminate-after 2026-05-23T00:00:00Z
  ./scripts/benchmark --run-id <run-id>
  ./scripts/down
EOF
}

parse_args() {
  while (($# > 0)); do
    case "$1" in
      -h|--help)
        usage
        exit 0
        ;;
      --platform)
        require_value "$1" "${2:-}"
        [[ "${2:-}" == "runpod" ]] || die "scripts/runpod-up supports only --platform runpod"
        shift 2
        ;;
      --gpu-id)
        require_value "$1" "${2:-}"
        RUNPOD_GPU_ID=${2:-}
        shift 2
        ;;
      --gpu-count)
        require_value "$1" "${2:-}"
        RUNPOD_GPU_COUNT=${2:-}
        shift 2
        ;;
      --cloud-type)
        require_value "$1" "${2:-}"
        RUNPOD_CLOUD_TYPE=${2:-}
        RUNPOD_CLOUD_TYPE_SET=1
        shift 2
        ;;
      --image)
        require_value "$1" "${2:-}"
        RUNPOD_IMAGE=${2:-}
        shift 2
        ;;
      --template-id)
        require_value "$1" "${2:-}"
        RUNPOD_TEMPLATE_ID=${2:-}
        shift 2
        ;;
      --container-disk-gb)
        require_value "$1" "${2:-}"
        RUNPOD_CONTAINER_DISK_GB=${2:-}
        shift 2
        ;;
      --volume-gb)
        require_value "$1" "${2:-}"
        RUNPOD_VOLUME_GB=${2:-}
        shift 2
        ;;
      --network-volume-id)
        require_value "$1" "${2:-}"
        RUNPOD_NETWORK_VOLUME_ID=${2:-}
        shift 2
        ;;
      --data-center-ids)
        require_value "$1" "${2:-}"
        RUNPOD_DATA_CENTER_IDS=${2:-}
        shift 2
        ;;
      --terminate-after)
        require_value "$1" "${2:-}"
        RUNPOD_TERMINATE_AFTER=${2:-}
        shift 2
        ;;
      --install-nsight-compute)
        RUNPOD_INSTALL_NCU=1
        shift
        ;;
      --no-install-nsight-compute)
        RUNPOD_INSTALL_NCU=0
        shift
        ;;
      --profile-counters)
        RUNPOD_PROFILE_COUNTERS=1
        shift
        ;;
      --name)
        require_value "$1" "${2:-}"
        RUNPOD_NAME=${2:-}
        shift 2
        ;;
      --docker-args)
        require_value "$1" "${2:-}"
        RUNPOD_DOCKER_ARGS=${2:-}
        shift 2
        ;;
      --key-file)
        require_value "$1" "${2:-}"
        KEY_FILE=$(absolute_path "${2:-}")
        shift 2
        ;;
      --ssh-user)
        require_value "$1" "${2:-}"
        SSH_USER=${2:-}
        shift 2
        ;;
      --remote-dir)
        require_value "$1" "${2:-}"
        REMOTE_DIR=${2:-}
        shift 2
        ;;
      --skip-bootstrap)
        SKIP_BOOTSTRAP=1
        shift
        ;;
      --connection-file)
        require_value "$1" "${2:-}"
        CONNECTION_FILE=$(absolute_path "${2:-}")
        shift 2
        ;;
      --dry-run)
        DRY_RUN=1
        shift
        ;;
      *)
        die "unknown Runpod argument: $1"
        ;;
    esac
  done
}

default_key_suffix() {
  local suffix

  suffix=${USER:-$(id -un 2>/dev/null || printf 'user')}
  suffix=${suffix//[^A-Za-z0-9._-]/-}
  printf '%s\n' "${suffix}"
}

resolve_default_key() {
  if [[ -z "${KEY_FILE}" ]]; then
    KEY_FILE="${KEY_DIR}/cuda-kernel-lab-runpod-$(default_key_suffix)"
  fi
}

validate_slug() {
  local label=$1
  local value=$2

  [[ "${value}" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || {
    die "${label} must use only letters, numbers, dots, underscores, and dashes"
  }
}

validate_positive_integer() {
  local label=$1
  local value=$2

  [[ "${value}" =~ ^[1-9][0-9]*$ ]] || die "${label} must be a positive integer"
}

validate_relative_path() {
  local label=$1
  local value=$2

  [[ "${value}" =~ ^[A-Za-z0-9._/-]+$ ]] || die "${label} contains unsafe characters"
  [[ "${value}" != /* && "${value}" != *..* ]] || {
    die "${label} must be a relative path without '..'"
  }
  [[ "${value}" != "." && "${value}" != .* && "${value}" != */.* ]] || {
    die "${label} must not target hidden or current-directory paths"
  }
}

validate_inputs() {
  validate_slug "--name" "${RUNPOD_NAME}"
  validate_positive_integer "--gpu-count" "${RUNPOD_GPU_COUNT}"
  validate_positive_integer "--container-disk-gb" "${RUNPOD_CONTAINER_DISK_GB}"
  validate_positive_integer "--volume-gb" "${RUNPOD_VOLUME_GB}"
  [[ "${RUNPOD_CLOUD_TYPE}" == "SECURE" || "${RUNPOD_CLOUD_TYPE}" == "COMMUNITY" ]] || {
    die "--cloud-type must be SECURE or COMMUNITY"
  }
  [[ "${RUNPOD_INSTALL_NCU}" == "0" || "${RUNPOD_INSTALL_NCU}" == "1" ]] || {
    die "CUDA_KERNEL_LAB_RUNPOD_INSTALL_NCU must be 0 or 1"
  }
  [[ "${RUNPOD_PROFILE_COUNTERS}" == "0" || "${RUNPOD_PROFILE_COUNTERS}" == "1" ]] || {
    die "CUDA_KERNEL_LAB_RUNPOD_PROFILE_COUNTERS must be 0 or 1"
  }
  if [[ "${RUNPOD_PROFILE_COUNTERS}" == "1" && "${RUNPOD_INSTALL_NCU}" != "1" ]]; then
    die "--profile-counters requires Nsight Compute; remove --no-install-nsight-compute"
  fi
  [[ -n "${RUNPOD_TEMPLATE_ID}" || -n "${RUNPOD_IMAGE}" ]] || {
    die "either --template-id or --image is required"
  }
  [[ "${SSH_USER}" =~ ^[A-Za-z_][A-Za-z0-9_.-]*[$]?$ ]] || die "--ssh-user contains unsafe characters"
  validate_relative_path "--remote-dir" "${REMOTE_DIR}"
}

resolve_profile_defaults() {
  if [[ "${RUNPOD_PROFILE_COUNTERS}" == "1" && "${RUNPOD_CLOUD_TYPE_SET}" == "0" ]]; then
    RUNPOD_CLOUD_TYPE="COMMUNITY"
  fi
}

check_prereqs() {
  if [[ "${DRY_RUN}" == "0" ]]; then
    require_commands runpodctl ssh-keygen ssh tar python3
  fi
}

ensure_ssh_key() {
  [[ "${DRY_RUN}" == "0" ]] || return 0

  mkdir -p "$(dirname "${KEY_FILE}")"
  if [[ ! -f "${KEY_FILE}" ]]; then
    print_stage "creating Runpod SSH key"
    ssh-keygen -t ed25519 -C "cuda-kernel-lab-runpod" -N "" -f "${KEY_FILE}" >/dev/null
  fi
  chmod 600 "${KEY_FILE}"

  if [[ ! -f "${KEY_FILE}.pub" ]]; then
    ssh-keygen -y -f "${KEY_FILE}" > "${KEY_FILE}.pub"
  fi

  print_stage "registering Runpod SSH key"
  if ! runpodctl ssh add-key --key-file "${KEY_FILE}.pub" >/dev/null 2>&1; then
    printf 'warning: could not add SSH key with runpodctl; continuing in case it is already registered\n' >&2
  fi
}

json_first_value() {
  python3 -c '
import json
import sys

names = set(sys.argv[1:])
payload = json.load(sys.stdin)

def walk(value):
    if isinstance(value, dict):
        for key, item in value.items():
            if key in names and item not in (None, ""):
                print(item)
                raise SystemExit(0)
        for item in value.values():
            walk(item)
    elif isinstance(value, list):
        for item in value:
            walk(item)

walk(payload)
raise SystemExit(1)
' "$@"
}

json_ssh_value() {
  local field=$1

  python3 -c '
import json
import shlex
import sys

field = sys.argv[1]
payload = json.load(sys.stdin)

def walk(value, names):
    if isinstance(value, dict):
        for key, item in value.items():
            if key in names and item not in (None, ""):
                return item
        for item in value.values():
            found = walk(item, names)
            if found not in (None, ""):
                return found
    elif isinstance(value, list):
        for item in value:
            found = walk(item, names)
            if found not in (None, ""):
                return found
    return None

command = walk(payload, {"sshCommand", "command", "ssh"})
tokens = shlex.split(command) if isinstance(command, str) else []

def from_command(target):
    if target == "port":
        for index, token in enumerate(tokens):
            if token == "-p" and index + 1 < len(tokens):
                return tokens[index + 1]
            if token.startswith("-p") and len(token) > 2:
                return token[2:]
    if target in {"user", "host"}:
        for token in tokens:
            if "@" in token and not token.startswith("-"):
                user, host = token.rsplit("@", 1)
                return user if target == "user" else host
    return None

if field == "host":
    value = walk(payload, {"host", "hostname", "ip", "ipAddress", "sshHost"}) or from_command("host")
elif field == "port":
    value = walk(payload, {"port", "sshPort"}) or from_command("port")
elif field == "user":
    value = walk(payload, {"user", "username", "sshUser"}) or from_command("user")
else:
    value = None

if value in (None, ""):
    raise SystemExit(1)
print(value)
' "${field}"
}

runpod_create_args() {
  RUNPOD_CREATE_ARGS=(runpodctl pod create -o json)
  if [[ -n "${RUNPOD_TEMPLATE_ID}" ]]; then
    RUNPOD_CREATE_ARGS+=(--template-id "${RUNPOD_TEMPLATE_ID}")
  else
    RUNPOD_CREATE_ARGS+=(--image "${RUNPOD_IMAGE}")
  fi
  RUNPOD_CREATE_ARGS+=(
    --name "${RUNPOD_NAME}"
    --gpu-id "${RUNPOD_GPU_ID}"
    --gpu-count "${RUNPOD_GPU_COUNT}"
    --cloud-type "${RUNPOD_CLOUD_TYPE}"
    --container-disk-in-gb "${RUNPOD_CONTAINER_DISK_GB}"
    --volume-in-gb "${RUNPOD_VOLUME_GB}"
    --volume-mount-path "${RUNPOD_VOLUME_MOUNT_PATH}"
    --ports "22/tcp"
    --ssh
  )
  if [[ -n "${RUNPOD_DOCKER_ARGS}" ]]; then
    RUNPOD_CREATE_ARGS+=(--docker-args "${RUNPOD_DOCKER_ARGS}")
  fi
  if [[ -n "${RUNPOD_NETWORK_VOLUME_ID}" ]]; then
    RUNPOD_CREATE_ARGS+=(--network-volume-id "${RUNPOD_NETWORK_VOLUME_ID}")
  fi
  if [[ -n "${RUNPOD_DATA_CENTER_IDS}" ]]; then
    RUNPOD_CREATE_ARGS+=(--data-center-ids "${RUNPOD_DATA_CENTER_IDS}")
  fi
  if [[ -n "${RUNPOD_TERMINATE_AFTER}" ]]; then
    RUNPOD_CREATE_ARGS+=(--terminate-after "${RUNPOD_TERMINATE_AFTER}")
  fi
}

create_pod() {
  local output

  print_stage "creating Runpod Pod"
  runpod_create_args
  output=$("${RUNPOD_CREATE_ARGS[@]}")
  RUNPOD_POD_ID=$(printf '%s\n' "${output}" | json_first_value id podId pod_id) || {
    printf '%s\n' "${output}" >&2
    die "could not read Pod id from runpodctl output"
  }
}

load_ssh_info() {
  local deadline
  local info

  deadline=$((SECONDS + 900))
  while ((SECONDS < deadline)); do
    if info=$(runpodctl ssh info "${RUNPOD_POD_ID}" -o json 2>/dev/null); then
      SSH_HOST=$(printf '%s\n' "${info}" | json_ssh_value host || true)
      SSH_PORT=$(printf '%s\n' "${info}" | json_ssh_value port || true)
      SSH_USER=$(printf '%s\n' "${info}" | json_ssh_value user || true)
      SSH_PORT=${SSH_PORT:-22}
      SSH_USER=${SSH_USER:-root}
      if [[ -n "${SSH_HOST}" ]]; then
        return 0
      fi
    fi
    sleep 10
  done

  die "timed out waiting for Runpod SSH connection info"
}

write_env_var() {
  local name=$1
  local value=$2

  printf '%s=' "${name}"
  printf '%q' "${value}"
  printf '\n'
}

write_connection_metadata() {
  mkdir -p "$(dirname "${CONNECTION_FILE}")"
  {
    write_env_var "PROVIDER_PLATFORM" "runpod"
    write_env_var "RUNPOD_POD_ID" "${RUNPOD_POD_ID}"
    write_env_var "RUNPOD_GPU_ID" "${RUNPOD_GPU_ID}"
    write_env_var "RUNPOD_GPU_COUNT" "${RUNPOD_GPU_COUNT}"
    write_env_var "RUNPOD_CLOUD_TYPE" "${RUNPOD_CLOUD_TYPE}"
    write_env_var "RUNPOD_IMAGE" "${RUNPOD_IMAGE}"
    write_env_var "RUNPOD_TEMPLATE_ID" "${RUNPOD_TEMPLATE_ID}"
    write_env_var "RUNPOD_NETWORK_VOLUME_ID" "${RUNPOD_NETWORK_VOLUME_ID}"
    write_env_var "RUNPOD_DATA_CENTER_IDS" "${RUNPOD_DATA_CENTER_IDS}"
    write_env_var "RUNPOD_PROFILE_COUNTERS" "${RUNPOD_PROFILE_COUNTERS}"
    write_env_var "KEY_FILE" "${KEY_FILE}"
    write_env_var "SSH_USER" "${SSH_USER}"
    write_env_var "SSH_HOST" "${SSH_HOST}"
    write_env_var "SSH_PORT" "${SSH_PORT}"
    write_env_var "REMOTE_DIR" "${REMOTE_DIR}"
  } > "${CONNECTION_FILE}"
  chmod 600 "${CONNECTION_FILE}"
}

ssh_base_args=()

configure_ssh_args() {
  mkdir -p "${STATE_DIR}"
  ssh_base_args=(
    -i "${KEY_FILE}"
    -p "${SSH_PORT}"
    -o StrictHostKeyChecking=accept-new
    -o UserKnownHostsFile="${STATE_DIR}/known_hosts"
    -o ConnectTimeout=10
    -o ServerAliveInterval=15
  )
}

ssh_remote() {
  # shellcheck disable=SC2029
  ssh "${ssh_base_args[@]}" "${SSH_USER}@${SSH_HOST}" "$@"
}

wait_for_ssh() {
  local deadline
  local last_error=""
  local output

  deadline=$((SECONDS + 900))
  while ((SECONDS < deadline)); do
    if output=$(ssh_remote 'echo ready' 2>&1); then
      return 0
    fi
    last_error=${output}
    sleep 10
  done

  printf 'SSH did not become reachable before timeout.\n' >&2
  printf '  Host: %s@%s:%s\n' "${SSH_USER}" "${SSH_HOST}" "${SSH_PORT}" >&2
  if [[ -n "${last_error}" ]]; then
    printf '  Last ssh error: %s\n' "${last_error}" >&2
  fi
  die "timed out waiting for SSH on Runpod Pod ${RUNPOD_POD_ID}"
}

sync_repo() {
  ssh_remote "rm -rf ~/${REMOTE_DIR} && mkdir -p ~/${REMOTE_DIR}"

  tar \
    --no-xattrs \
    --exclude='.aws-gpu' \
    --exclude='.runpod' \
    --exclude='.git' \
    --exclude='.mypy_cache' \
    --exclude='.pytest_cache' \
    --exclude='.ruff_cache' \
    --exclude='.terraform' \
    --exclude='.venv' \
    --exclude='*.tfvars' \
    --exclude='*.tfvars.json' \
    --exclude='*.tfstate' \
    --exclude='*.tfstate.*' \
    --exclude='*.tfplan' \
    --exclude='tfplan' \
    --exclude='benchmarks/results' \
    --exclude='experiments/results' \
    --exclude='profiling/**/captures' \
    --exclude='profiling/**/raw' \
    -czf - \
    -C "${REPO_ROOT}" . \
    | ssh_remote "tar -xzf - -C \$HOME/${REMOTE_DIR}"
}

bootstrap_remote() {
  ssh_remote \
    "REMOTE_DIR=$(shell_quote "${REMOTE_DIR}") CUDA_KERNEL_LAB_INSTALL_NCU=$(shell_quote "${RUNPOD_INSTALL_NCU}") CUDA_KERNEL_LAB_PROFILE_COUNTERS=$(shell_quote "${RUNPOD_PROFILE_COUNTERS}") bash -s" \
    <<'REMOTE_BOOTSTRAP'
set -Eeuo pipefail

find_ncu_bin() {
  if command -v ncu >/dev/null 2>&1; then
    command -v ncu
    return 0
  fi

  local candidate
  for candidate in \
    /usr/local/cuda/bin/ncu \
    /opt/nvidia/nsight-compute/*/ncu \
    /usr/local/NVIDIA-Nsight-Compute*/ncu; do
    if [[ -x "${candidate}" ]]; then
      printf '%s\n' "${candidate}"
      return 0
    fi
  done
  return 1
}

run_privileged() {
  if [[ "$(id -u)" == "0" ]]; then
    "$@"
  elif command -v sudo >/dev/null 2>&1 && sudo -n true >/dev/null 2>&1; then
    sudo -n "$@"
  else
    printf 'error: installing Nsight Compute requires root or passwordless sudo\n' >&2
    return 1
  fi
}

cuda_repo_label() {
  local os_id=""
  local version_id=""

  if [[ -r /etc/os-release ]]; then
    # shellcheck disable=SC1091
    . /etc/os-release
    os_id=${ID:-}
    version_id=${VERSION_ID:-}
  fi

  if [[ "${os_id}" == "ubuntu" && -n "${version_id}" ]]; then
    printf 'ubuntu%s\n' "${version_id//./}"
    return 0
  fi
  return 1
}

nsight_compute_package() {
  local package

  package=$(apt-cache search '^nsight-compute$' 2>/dev/null | awk '{print $1}' | head -n 1)
  if [[ -n "${package}" ]]; then
    printf '%s\n' "${package}"
    return 0
  fi

  apt-cache search '^nsight-compute' 2>/dev/null \
    | awk '{print $1}' \
    | sort -V \
    | tail -n 1
}

ensure_cuda_apt_repo() {
  local repo_label
  local keyring_deb

  if [[ -e /etc/apt/sources.list.d/cuda-*.list ]] \
    || [[ -e /etc/apt/sources.list.d/cuda.sources ]]; then
    return 0
  fi

  repo_label=$(cuda_repo_label) || {
    printf 'error: could not infer CUDA apt repo from /etc/os-release\n' >&2
    return 1
  }
  if ! command -v curl >/dev/null 2>&1; then
    run_privileged apt-get update
    run_privileged env DEBIAN_FRONTEND=noninteractive apt-get install -y curl ca-certificates
  fi
  keyring_deb=$(mktemp --suffix=.deb)
  curl -fsSL \
    "https://developer.download.nvidia.com/compute/cuda/repos/${repo_label}/x86_64/cuda-keyring_1.1-1_all.deb" \
    -o "${keyring_deb}"
  run_privileged dpkg -i "${keyring_deb}"
  rm -f "${keyring_deb}"
}

install_nsight_compute() {
  local ncu_bin
  local package

  if ncu_bin=$(find_ncu_bin); then
    "${ncu_bin}" --version | head -n 1
    return 0
  fi
  command -v apt-get >/dev/null 2>&1 || {
    printf 'error: apt-get is required to install Nsight Compute on this image\n' >&2
    return 1
  }

  printf '==> installing Nsight Compute on remote host\n'
  run_privileged apt-get update
  package=$(nsight_compute_package)
  if [[ -z "${package}" ]]; then
    ensure_cuda_apt_repo
    run_privileged apt-get update
    package=$(nsight_compute_package)
  fi
  [[ -n "${package}" ]] || {
    printf 'error: no nsight-compute package was found in apt repositories\n' >&2
    return 1
  }

  run_privileged env DEBIAN_FRONTEND=noninteractive apt-get install -y "${package}"
  ncu_bin=$(find_ncu_bin) || {
    printf 'error: installed %s but could not locate ncu\n' "${package}" >&2
    return 1
  }
  "${ncu_bin}" --version | head -n 1
}

check_ncu_counter_access() {
  local ncu_bin
  local python_bin
  local tmp_dir
  local out_path
  local err_path

  ncu_bin=$(find_ncu_bin) || {
    printf 'error: ncu was not found for profile counter validation\n' >&2
    return 1
  }
  python_bin=".venv/bin/python"
  if [[ ! -x "${python_bin}" ]]; then
    python_bin="python"
  fi

  tmp_dir=$(mktemp -d)
  out_path="${tmp_dir}/ncu-counter.csv"
  err_path="${tmp_dir}/ncu-counter.stderr"

  if run_privileged env HOME="${HOME}" PATH="${PATH}" "${ncu_bin}" \
    --metrics launch__registers_per_thread \
    --target-processes all \
    --profile-from-start off \
    --launch-count 1 \
    --csv \
    "${python_bin}" -m cuda_kernel_lab.profile_capture matmul \
      --m 128 --n 128 --k 128 --dtype float16 --device cuda \
      --block-m 32 --block-n 32 --block-k 32 \
      --num-warps 4 --num-stages 3 --input-precision tf32 --group-m 1 \
      --warmup 1 --profile-iterations 1 \
      > "${out_path}" 2> "${err_path}"; then
    :
  fi

  if grep -q 'ERR_NVGPUCTRPERM' "${out_path}" "${err_path}" 2>/dev/null; then
    printf 'error: Nsight Compute cannot access NVIDIA performance counters on this Pod (ERR_NVGPUCTRPERM).\n' >&2
    printf 'error: try ./scripts/up --profile-counters without forcing SECURE, or choose a Runpod host/datacenter that enables profiler counters.\n' >&2
    cat "${out_path}" >&2
    cat "${err_path}" >&2
    rm -rf "${tmp_dir}"
    return 1
  fi

  if grep -Eq 'Metric Name|Kernel Name|launch__registers_per_thread' "${out_path}"; then
    printf 'Nsight counter access: ok\n'
    rm -rf "${tmp_dir}"
    return 0
  fi

  printf 'error: Nsight Compute counter validation did not produce metrics.\n' >&2
  cat "${out_path}" >&2
  cat "${err_path}" >&2
  rm -rf "${tmp_dir}"
  return 1
}

cd "${HOME}/${REMOTE_DIR}"
if ! command -v uv >/dev/null 2>&1; then
  uv_installer=$(mktemp)
  curl -LsSf https://astral.sh/uv/install.sh -o "${uv_installer}"
  sh "${uv_installer}"
  rm -f "${uv_installer}"
fi
export PATH="${HOME}/.local/bin:${PATH}"
uv sync --group dev --extra gpu
if [[ "${CUDA_KERNEL_LAB_INSTALL_NCU}" == "1" ]]; then
  install_nsight_compute
fi
uv run gpu-info
if [[ "${CUDA_KERNEL_LAB_PROFILE_COUNTERS:-0}" == "1" ]]; then
  check_ncu_counter_access
fi
uv run benchmark-matrix --include-vector-add-sweep --include-reduction-sweep --dry-run
REMOTE_BOOTSTRAP
}

print_launch_summary() {
  runpod_create_args
  printf '\nRunpod launch configuration:\n'
  if [[ "${DRY_RUN}" == "1" ]]; then
    printf '  Mode: dry run; no Runpod commands will run\n'
  fi
  printf '  Pod name: %s\n' "${RUNPOD_NAME}"
  printf '  GPU: %s x%s\n' "${RUNPOD_GPU_ID}" "${RUNPOD_GPU_COUNT}"
  printf '  Cloud type: %s\n' "${RUNPOD_CLOUD_TYPE}"
  if [[ -n "${RUNPOD_TEMPLATE_ID}" ]]; then
    printf '  Template: %s\n' "${RUNPOD_TEMPLATE_ID}"
  else
    printf '  Image: %s\n' "${RUNPOD_IMAGE}"
  fi
  printf '  Container disk: %s GiB\n' "${RUNPOD_CONTAINER_DISK_GB}"
  printf '  Pod volume: %s GiB mounted at %s\n' "${RUNPOD_VOLUME_GB}" "${RUNPOD_VOLUME_MOUNT_PATH}"
  if [[ -n "${RUNPOD_NETWORK_VOLUME_ID}" ]]; then
    printf '  Network volume: %s\n' "${RUNPOD_NETWORK_VOLUME_ID}"
  fi
  if [[ -n "${RUNPOD_DATA_CENTER_IDS}" ]]; then
    printf '  Datacenters: %s\n' "${RUNPOD_DATA_CENTER_IDS}"
  fi
  if [[ -n "${RUNPOD_TERMINATE_AFTER}" ]]; then
    printf '  Terminate after: %s\n' "${RUNPOD_TERMINATE_AFTER}"
  fi
  if [[ "${RUNPOD_INSTALL_NCU}" == "1" ]]; then
    printf '  Nsight Compute: install/validate ncu during bootstrap\n'
  else
    printf '  Nsight Compute: skip install\n'
  fi
  if [[ "${RUNPOD_PROFILE_COUNTERS}" == "1" ]]; then
    printf '  Nsight counters: validate access during bootstrap\n'
  else
    printf '  Nsight counters: skip access validation\n'
  fi
  printf '  SSH key file: %s\n' "${KEY_FILE}"
  printf '  Remote repo: ~/%s\n' "${REMOTE_DIR}"
  printf '  Connection metadata: %s\n' "${CONNECTION_FILE}"
  printf '  Create command:'
  printf ' %q' "${RUNPOD_CREATE_ARGS[@]}"
  printf '\n'
}

print_teardown_command() {
  printf '  Tear down: ./scripts/down --platform runpod\n'
}

print_ready() {
  printf '\nReady:\n'
  printf '  Pod: %s\n' "${RUNPOD_POD_ID}"
  printf '  SSH: ssh -i %q -p %q %s@%s\n' "${KEY_FILE}" "${SSH_PORT}" "${SSH_USER}" "${SSH_HOST}"
  printf '  Repo: ~/%s\n' "${REMOTE_DIR}"
  printf '  Connection metadata: %s\n' "${CONNECTION_FILE}"
  printf '  Benchmark: ./scripts/benchmark --run-id <run-id>\n'
  print_teardown_command
}

main() {
  parse_args "$@"
  resolve_profile_defaults
  resolve_default_key
  validate_inputs
  check_prereqs
  print_launch_summary

  if [[ "${DRY_RUN}" == "1" ]]; then
    print_stage "dry run complete"
    return 0
  fi

  ensure_ssh_key
  create_pod
  load_ssh_info
  write_connection_metadata

  if [[ "${SKIP_BOOTSTRAP}" == "0" ]]; then
    print_stage "syncing repo and bootstrapping GPU benchmark environment"
    configure_ssh_args
    wait_for_ssh
    sync_repo
    bootstrap_remote
  else
    print_stage "skipping SSH bootstrap"
  fi

  print_ready
}

main "$@"
